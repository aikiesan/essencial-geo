{
  "name": "essencial-geo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Essencial Geo — feed cartográfico, repositório de dados abertos e portfólio de mapas temáticos do Brasil.",
  "license": "CC-BY-4.0",
  "scripts": {
    "sincronizar": "node scripts/sincronizar-mapas.mjs",
    "dev": "npm run sincronizar && astro dev",
    "build": "npm run sincronizar -- --publicadas && astro build && node scripts/painel-cifrado.mjs",
    "preview": "astro preview",
    "novo-mapa": "node scripts/novo-mapa.mjs",
    "zenodo": "node scripts/zenodo-publicar.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource-variable/lora": "^5.2.0",
    "@fontsource-variable/playfair-display": "^5.2.0",
    "astro": "~5.18.2",
    "qrcode": "~1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "~1.5.5",
    "d3-geo": "^3.1.1",
    "geotiff": "^3.0.5",
    "sharp": "^0.34.5",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "yaml": "^2.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
