---
/** Feed dos mapas (/mapas/), paginado em folhas de 8 pranchas. A página inicial é a galeria (Inicio.astro). */
import type { Page } from 'astro';
import Base from '../layouts/Base.astro';
import ListaFeed from '../components/ListaFeed.astro';
import PainelFichas from '../components/PainelFichas.astro';
import type { Mapa } from '../lib/mapas';
import { linguaDe, t } from '../i18n';
import { SITE } from '../site.config';

interface Props { page: Page<Mapa> }
const { page } = Astro.props;
const tx = t(linguaDe(Astro.url.pathname));
const primeira = page.currentPage === 1;
---

<Base
  titulo={primeira ? tx.topo.mapas : `${tx.topo.mapas} · ${tx.feed.folha} ${page.currentPage}`}
  categoriaAtiva="todas"
  imagem={page.data[0]?.data.imagem.src}
>
  <header class="mancha feed">
    <h1 class="rotulo mancha__titulo"><span class="sr-only">{SITE.nome}: </span>{tx.feed.sobre} · {tx.feed.folha} {page.currentPage} {tx.feed.de} {page.lastPage}</h1>
    <p class="mancha__frase">{tx.feed.frase}</p>
  </header>

  <ListaFeed
    mapas={page.data}
    anterior={page.url.prev}
    proxima={page.url.next}
    pagina={page.currentPage}
    totalPaginas={page.lastPage}
  />

  <PainelFichas slot="direita" mapas={page.data} />
</Base>

<style>
  .mancha {
    margin-bottom: var(--e-7);
    padding-bottom: var(--e-4);
    border-bottom: 1px solid var(--linha);
  }
  .mancha .rotulo {
    margin: 0 0 var(--e-2);
  }
  .mancha__titulo {
    font-weight: 500;
    line-height: inherit;
  }
  .mancha__frase {
    margin: 0;
    font-family: var(--f-titulo);
    font-style: italic;
    font-size: var(--t-lg);
    line-height: 1.45;
    color: var(--tinta-2);
    max-width: 52ch;
  }
</style>
