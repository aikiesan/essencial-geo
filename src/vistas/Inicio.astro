---
/**
 * Página inicial: o que é o atlas e como usá-lo, em poucas linhas, e a galeria —
 * as coleções e todos os mapas no ar, com filtro por coleção. O feed de cartões
 * longos fica em /mapas/.
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import Estrela from '../components/Estrela.astro';
import Progresso from '../components/Progresso.astro';
import Perguntas from '../components/Perguntas.astro';
import MapaDosMapas from '../components/MapaDosMapas.astro';
import { colecoesNoAr } from '../lib/colecoes';
import { ESCOPOS, contarPorCategoria, escopoDoMapa, linkMapa, mapasPublicados, numeroFormatado, proximosMapas } from '../lib/mapas';
import { jsonLd, siteEAutor } from '../lib/metadados';
import { CATEGORIA_IDS, COLECOES, SITE } from '../site.config';
import { dataCurta, dataIso, linguaDe, rota, t } from '../i18n';

const lingua = linguaDe(Astro.url.pathname);
const tx = t(lingua);
const i = tx.inicio;

const mapas = await mapasPublicados(lingua);
const series = await colecoesNoAr(lingua);
const proximos = await proximosMapas(lingua, 3);
// Compilado antes das 9h, o mapa do dia ainda está na fila: aparece como "hoje", não como data passada.
const hojeBrasilia = new Date(Date.now() - 3 * 3600 * 1000).toISOString().slice(0, 10);
const contagem = contarPorCategoria(mapas);
// Novo esta semana: pranchas no ar há até sete dias. Sem nenhuma, a leva mais recente ("as últimas no ar").
const noArDeFato = mapas.filter((m) => !m.agendado && !m.data.rascunho);
const semana = Date.now() - 7 * 86400_000;
const daSemana = noArDeFato.filter((m) => m.data.data.getTime() >= semana);
const ultimoDia = noArDeFato[0] && dataIso(noArDeFato[0].data.data);
const novidades = (daSemana.length ? daSemana : noArDeFato.filter((m) => dataIso(m.data.data) === ultimoDia)).slice(0, 10);
const temas = CATEGORIA_IDS.filter((c) => contagem[c] > 0).length;
const categorias = CATEGORIA_IDS.filter((c) => contagem[c] > 0);
const escopos = ESCOPOS.map((e) => ({ id: e, n: mapas.filter((m) => escopoDoMapa(m) === e).length })).filter((e) => e.n > 0);
// Texto em que a busca procura: número, título, subtítulo, recorte, coleção, tema e etiquetas, sem acentos.
const semAcento = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
const busca = (m: (typeof mapas)[number]) =>
  semAcento(
    [
      numeroFormatado(m.data.numero),
      m.data.titulo,
      m.data.subtitulo,
      m.data.recorte,
      m.original.recorte,
      m.data.colecao && COLECOES[m.data.colecao][lingua].titulo,
      tx.categorias[m.data.categoria].rotulo,
      m.data.tags.join(' ').replaceAll('-', ' '),
    ]
      .filter(Boolean)
      .join(' '),
  );
---

<Base imagem={mapas[0]?.data.imagem.src}>
  <script slot="head" type="application/ld+json" set:html={jsonLd(siteEAutor(lingua, tx.site.descricao, Astro.site))} />

  <div class="inicio">
    <header class="abertura moldura">
      <span class="coord coord--n" aria-hidden="true">{i.latitude}</span>
      <span class="coord coord--s" aria-hidden="true">{i.longitude}</span>
      <p class="rotulo">{i.sobre}</p>
      <h1 class="abertura__titulo"><span class="sr-only">{SITE.nome}: </span>{i.titulo}</h1>
      <p class="abertura__texto">{i.texto}</p>

      <h2 class="sr-only">{i.passos}</h2>
      <ol class="passos" role="list">
        <li>
          <span class="passos__n mono">01</span>
          <strong>{i.passo1}</strong>
          <span>{i.passo1Texto}</span>
        </li>
        <li>
          <span class="passos__n mono">02</span>
          <strong>{i.passo2}</strong>
          <span>{i.passo2Texto}</span>
        </li>
        <li>
          <span class="passos__n mono">03</span>
          <strong>{i.passo3}</strong>
          <span>{i.passo3Texto}</span>
        </li>
      </ol>

      <dl class="numeros">
        <div><dt>{i.noAr}</dt><dd>{mapas.length}</dd></div>
        <div><dt>{i.colecoes}</dt><dd>{series.length}</dd></div>
        <div><dt>{i.temas}</dt><dd>{temas}</dd></div>
        <div><dt>{i.licenca}</dt><dd>{SITE.licenca.nome}</dd></div>
      </dl>
      <p class="abertura__guia">
        <Icone nome="guia" tamanho={14} />
        <a href={rota(lingua, 'guia')}>{i.guia}</a>
      </p>
    </header>
    <p class="regua" aria-hidden="true">{tx.site.colofao}</p>

    {
      novidades.length > 0 && (
        <section class="bloco" aria-labelledby="t-novidades">
          <div class="bloco__cabeca">
            <h2 id="t-novidades">{daSemana.length ? i.novidades : i.ultimas}</h2>
            <p>
              {daSemana.length
                ? i.novidadesFina
                : i.ultimasFina.replace('{data}', dataCurta(novidades[0].data.data, lingua))}
            </p>
          </div>
          <ol class="novidades" role="list">
            {novidades.map((m, n) => (
              <li>
                <a class="mapa" href={linkMapa(m)}>
                  <span class="mapa__capa">
                    <Image
                      src={m.data.imagem}
                      alt=""
                      widths={[280, 420]}
                      sizes="220px"
                      loading={n < 4 ? 'eager' : 'lazy'}
                      format="webp"
                      quality={72}
                    />
                  </span>
                  <span class="mapa__no rotulo">
                    {tx.geral.no} {numeroFormatado(m.data.numero)} · <time datetime={dataIso(m.data.data)}>{dataCurta(m.data.data, lingua)}</time>
                  </span>
                  <span class="mapa__titulo">{m.data.titulo}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      series.length > 0 && (
        <section class="bloco" aria-labelledby="t-perguntas">
          <div class="bloco__cabeca">
            <h2 id="t-perguntas">{i.perguntas}</h2>
            <p>{i.perguntasFina}</p>
          </div>
          <Perguntas series={series} />
        </section>
      )
    }

    {
      series.length > 0 && (
        <section class="bloco" aria-labelledby="t-galeria-colecoes">
          <div class="bloco__cabeca">
            <h2 id="t-galeria-colecoes">{i.galeriaColecoes}</h2>
            <p>{i.galeriaColecoesFina}</p>
          </div>
          <ul class="colecoes" role="list">
            {series.map((c, n) => {
              const total = Math.max(c.ordem.length, c.mapas.length);
              return (
                <li>
                  <a class="colecao" href={rota(lingua, 'colecoes', c.id)}>
                    <span class="colecao__capa">
                      <Image
                        src={c.mapas[0].data.imagem}
                        alt=""
                        widths={[320, 480, 640]}
                        sizes="(min-width: 1100px) 320px, (min-width: 600px) 45vw, calc(100vw - 32px)"
                        loading={n < 3 ? 'eager' : 'lazy'}
                        format="webp"
                        quality={74}
                      />
                    </span>
                    <span class="colecao__titulo">{c.titulo}</span>
                    <Progresso feitos={c.mapas.length} total={total} compacto />
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    <section class="bloco" aria-labelledby="t-mdm">
      <div class="bloco__cabeca">
        <h2 id="t-mdm">{i.mapaDosMapas}</h2>
        <p>{i.mapaDosMapasFina}</p>
      </div>
      <MapaDosMapas mapas={mapas} />
    </section>

    <section class="bloco" id="galeria" aria-labelledby="t-galeria-mapas">
      <div class="bloco__cabeca">
        <h2 id="t-galeria-mapas">{i.galeriaMapas}</h2>
        <p>{i.galeriaMapasFina}</p>
      </div>

      <form class="filtros" data-filtros role="search" aria-label={i.filtro}>
        <label class="filtros__campo filtros__busca">
          <span class="rotulo">{i.buscar}</span>
          <input type="search" name="q" placeholder={i.buscarDica} autocomplete="off" spellcheck="false" />
        </label>
        {
          series.length > 1 && (
            <label class="filtros__campo">
              <span class="rotulo">{i.colecao}</span>
              <select name="colecao">
                <option value="">{i.colecaoTodas}</option>
                {series.map((c) => (
                  <option value={c.id}>
                    {c.titulo} ({c.mapas.length})
                  </option>
                ))}
              </select>
            </label>
          )
        }
        {
          categorias.length > 1 && (
            <label class="filtros__campo">
              <span class="rotulo">{i.tema}</span>
              <select name="tema">
                <option value="">{i.temaTodos}</option>
                {categorias.map((c) => (
                  <option value={c}>
                    {tx.categorias[c].curto} ({contagem[c]})
                  </option>
                ))}
              </select>
            </label>
          )
        }
        {
          escopos.length > 1 && (
            <fieldset class="filtros__recorte">
              <legend class="rotulo">{i.recorte}</legend>
              <label>
                <input type="radio" name="recorte" value="" checked />
                <span>{i.escopos.todos}</span>
              </label>
              {escopos.map((e) => (
                <label>
                  <input type="radio" name="recorte" value={e.id} />
                  <span>
                    {i.escopos[e.id]} <span class="mono">{e.n}</span>
                  </span>
                </label>
              ))}
            </fieldset>
          )
        }
        <div class="filtros__estado">
          <p class="rotulo" data-filtro-contagem data-modelo={i.contagem} aria-live="polite">
            {i.contagem.replace('{n}', String(mapas.length)).replace('{total}', String(mapas.length))}
          </p>
          <button type="reset" class="filtros__limpar rotulo">{i.limpar}</button>
        </div>
      </form>

      <ul class="mapas" role="list" data-galeria>
        {
          mapas.map((m, n) => (
            <li data-colecao={m.data.colecao ?? ''} data-tema={m.data.categoria} data-recorte={escopoDoMapa(m)} data-busca={busca(m)}>
              <a class="mapa" href={linkMapa(m)}>
                <span class="mapa__capa">
                  <Image
                    src={m.data.imagem}
                    alt=""
                    widths={[280, 420, 560]}
                    sizes="(min-width: 1100px) 240px, (min-width: 600px) 30vw, calc(50vw - 24px)"
                    loading={n < 6 ? 'eager' : 'lazy'}
                    format="webp"
                    quality={72}
                  />
                </span>
                <span class="mapa__no rotulo">
                  {tx.geral.no} {numeroFormatado(m.data.numero)}
                  {m.data.colecao && <> · {COLECOES[m.data.colecao][lingua].titulo}</>}
                </span>
                <span class="mapa__titulo">{m.data.titulo}</span>
                <span class="mapa__recorte">{m.data.recorte}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="galeria-vazia" data-galeria-vazia hidden>
        <Estrela tamanho={12} /> {i.nenhum}
      </p>

      <a class="feed-link rotulo" href={rota(lingua, 'mapas')}>
        {i.lerFeed} <Icone nome="seta" tamanho={12} />
      </a>
    </section>

    {
      proximos.length > 0 && (
        <section class="bloco proximos" aria-labelledby="t-proximos">
          <div class="bloco__cabeca">
            <h2 id="t-proximos">{i.proximos}</h2>
            <p>{i.proximosFina}</p>
          </div>
          <ol class="proximos__lista" role="list">
            {proximos.map((m) => (
              <li>
                <time class="mono" datetime={m.data.data.toISOString().slice(0, 10)}>
                  {m.data.data.toISOString().slice(0, 10) === hojeBrasilia ? i.hoje : dataCurta(m.data.data, lingua)}
                </time>
                <Estrela tamanho={9} />
                <span>
                  <span class="proximos__titulo">{m.data.titulo}</span>
                  <span class="proximos__recorte">{m.data.recorte}</span>
                </span>
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </div>
</Base>

<style>
  .inicio {
    max-width: 1040px;
    margin: 0 auto;
  }

  /* Abertura: uma frase, um parágrafo, três passos e quatro números */
  .abertura {
    padding: var(--e-6) var(--e-5);
    background: var(--painel);
  }
  @media (min-width: 700px) {
    .abertura {
      padding: var(--e-7) var(--e-7) var(--e-6);
    }
  }
  .abertura__guia {
    display: flex;
    align-items: baseline;
    gap: var(--e-2);
    margin: var(--e-5) 0 0;
    font-size: var(--t-sm);
    font-style: italic;
    color: var(--tinta-2);
  }
  .abertura__guia :global(svg) {
    flex: none;
    align-self: center;
    color: var(--cesto);
  }
  .abertura__guia a {
    text-decoration-color: var(--cesto);
  }
  .abertura + .regua {
    margin-top: var(--e-3);
  }
  /* Novidades: uma faixa que rola de lado, com encaixe */
  .novidades {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(62vw, 220px);
    gap: var(--e-4);
    margin: 0;
    padding: 0 0 var(--e-3);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }
  .novidades li {
    scroll-snap-align: start;
  }
  .abertura .rotulo {
    margin: 0 0 var(--e-3);
  }
  .abertura__titulo {
    margin: 0 0 var(--e-4);
    font-size: var(--t-xxl);
    line-height: 1.08;
    max-width: 18ch;
  }
  .abertura__texto {
    margin: 0;
    max-width: 62ch;
    font-size: var(--t-lg);
    line-height: 1.6;
    color: var(--tinta-2);
  }
  .passos {
    display: grid;
    gap: var(--e-4);
    margin: var(--e-6) 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 700px) {
    .passos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0;
      border-top: 1px solid var(--linha-fina);
    }
    .passos li + li {
      border-left: 1px solid var(--linha-fina);
      padding-left: var(--e-4);
    }
    .passos li {
      padding: var(--e-4) var(--e-4) 0 0;
    }
  }
  .passos li {
    display: grid;
    gap: var(--e-1);
    font-size: var(--t-sm);
    line-height: 1.55;
    color: var(--tinta-2);
  }
  .passos strong {
    font-family: var(--f-titulo);
    font-size: var(--t-lg);
    font-weight: 500;
    color: var(--tinta);
  }
  .passos__n {
    font-size: var(--t-xs);
    color: var(--tinta-3);
  }
  .numeros {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--e-4);
    margin: var(--e-6) 0 0;
  }
  @media (min-width: 700px) {
    .numeros {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .numeros div {
    display: flex;
    flex-direction: column-reverse;
    gap: 2px;
    padding-top: var(--e-2);
    border-top: 1px solid var(--linha);
  }
  .numeros dt {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinta-3);
  }
  .numeros dd {
    margin: 0;
    font-family: var(--f-titulo);
    font-size: var(--t-xl);
    line-height: 1.1;
  }

  /* Blocos da galeria */
  .bloco {
    margin-top: var(--e-7);
    scroll-margin-top: calc(var(--topo) + var(--e-4));
  }
  .bloco__cabeca {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--e-1) var(--e-4);
    margin-bottom: var(--e-4);
    padding-bottom: var(--e-2);
    border-bottom: 1px solid var(--linha-fina);
  }
  .bloco__cabeca h2 {
    margin: 0;
    font-size: var(--t-xl);
  }
  .bloco__cabeca p {
    margin: 0;
    font-size: var(--t-sm);
    color: var(--tinta-3);
  }

  /* Coleções: capa, título e andamento */
  .colecoes,
  .mapas {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .colecoes {
    gap: var(--e-5);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
  }
  .colecao {
    display: grid;
    gap: var(--e-2);
    text-decoration: none;
    color: var(--tinta);
  }
  .colecao__capa,
  .mapa__capa {
    display: block;
    padding: 4px;
    border: 1px solid var(--linha);
    background: var(--folha);
    transition: border-color 120ms linear;
  }
  .colecao__capa :global(img),
  .mapa__capa :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: #fff;
  }
  .colecao:hover .colecao__capa,
  .mapa:hover .mapa__capa {
    border-color: var(--acento);
  }
  .colecao__titulo {
    font-family: var(--f-titulo);
    font-size: var(--t-lg);
    line-height: 1.25;
    transition: color 120ms linear;
  }
  .colecao:hover .colecao__titulo,
  .mapa:hover .mapa__titulo {
    color: var(--acento);
  }

  /* Busca e filtros: sem JavaScript, a galeria mostra tudo e o formulário some */
  .filtros {
    display: none;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--e-3) var(--e-4);
    margin-bottom: var(--e-5);
    padding: var(--e-4);
    border: 1px solid var(--linha-fina);
    background: var(--painel);
  }
  :global(.js) .filtros {
    display: grid;
  }
  @media (min-width: 700px) {
    .filtros {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
    }
    .filtros__recorte,
    .filtros__estado {
      grid-column: 1 / -1;
    }
  }
  .filtros__campo {
    display: grid;
    gap: var(--e-1);
    min-width: 0;
  }
  .filtros .rotulo {
    margin: 0;
  }
  .filtros input[type='search'],
  .filtros select {
    width: 100%;
    min-height: 40px;
    padding: 0 var(--e-3);
    border: 1px solid var(--linha-fina);
    background: var(--papel);
    color: var(--tinta);
    font: inherit;
    font-size: var(--t-sm);
  }
  .filtros input[type='search']:hover,
  .filtros select:hover {
    border-color: var(--tinta-3);
  }
  .filtros__recorte {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-2);
    margin: 0;
    padding: 0;
    border: 0;
  }
  .filtros__recorte legend {
    float: left;
    margin-right: var(--e-2);
  }
  .filtros__recorte label {
    position: relative;
  }
  .filtros__recorte input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .filtros__recorte label > span {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    min-height: 32px;
    padding: 0 var(--e-3);
    border: 1px solid var(--linha-fina);
    font-size: var(--t-sm);
    transition:
      border-color 120ms linear,
      background-color 120ms linear;
  }
  .filtros__recorte label:hover > span {
    border-color: var(--tinta-3);
  }
  .filtros__recorte input:checked + span {
    background: var(--trigo);
    border-color: var(--trigo);
  }
  .filtros__recorte input:focus-visible + span {
    outline: 2px solid var(--foco);
    outline-offset: 2px;
  }
  .filtros__recorte .mono {
    font-size: var(--t-xs);
    color: var(--tinta-3);
  }
  .filtros__estado {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-2);
    padding-top: var(--e-3);
    border-top: 1px solid var(--linha-fina);
  }
  .filtros__limpar {
    min-height: 32px;
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--linha-fina);
    background: transparent;
    color: var(--tinta-2);
  }
  .filtros__limpar:hover {
    color: var(--acento);
    border-color: var(--acento);
  }
  .galeria-vazia {
    display: flex;
    gap: var(--e-2);
    align-items: center;
    padding: var(--e-6);
    border: 1px dashed var(--linha-fina);
    font-style: italic;
    color: var(--tinta-2);
  }
  .galeria-vazia[hidden] {
    display: none;
  }

  /* Mapas: miniaturas em grade */
  .mapas {
    gap: var(--e-5) var(--e-4);
    grid-template-columns: repeat(auto-fill, minmax(min(46%, 220px), 1fr));
  }
  .mapas li[hidden] {
    display: none;
  }
  .mapa {
    display: grid;
    gap: var(--e-1);
    text-decoration: none;
    color: var(--tinta);
  }
  .mapa__capa {
    margin-bottom: var(--e-1);
  }
  .mapa__no {
