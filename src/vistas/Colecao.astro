---
/** Página de uma coleção: apresentação, andamento e as pranchas em ordem de leitura. */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Trilha from '../components/Trilha.astro';
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import ListaFeed from '../components/ListaFeed.astro';
import PainelFichas from '../components/PainelFichas.astro';
import Progresso from '../components/Progresso.astro';
import Icone from '../components/Icone.astro';
import type { Colecao } from '../lib/colecoes';
import { linkMapa, numeroFormatado } from '../lib/mapas';
import { dataCurta, linguaDe, rota, t } from '../i18n';

interface Props { colecao: Colecao }
const { colecao: c } = Astro.props;
const lingua = linguaDe(Astro.url.pathname);
const tx = t(lingua);
const total = Math.max(c.ordem.length, c.mapas.length);
---

<Base titulo={c.titulo} descricao={c.resumo} imagem={c.mapas[0]?.data.imagem.src}>
  <div class="feed">
    <Trilha
      itens={[
        { rotulo: tx.mapa.inicio, href: rota(lingua) },
        { rotulo: tx.topo.colecoes, href: rota(lingua, 'colecoes') },
        { rotulo: c.titulo },
      ]}
    />
    <CabecalhoPagina
      sobre={`${tx.colecoes.colecao} · ${total} ${total === 1 ? tx.colecoes.mapa : tx.colecoes.mapas}`}
      titulo={c.titulo}
      linhaFina={c.resumo}
    >
      <div class="andamento">
        <Progresso feitos={c.mapas.length} total={total} />
        {
          c.proxima && (
            <p class="rotulo">
              {tx.colecoes.proxima}: <span class="mono">{dataCurta(c.proxima, lingua)}</span>
            </p>
          )
        }
      </div>
      <p class="ordem">
        <span>{tx.colecoes.ordem}</span>
        <a class="rotulo" href={rota(lingua, 'colecoes')}><Icone nome="voltar" tamanho={11} /> {tx.colecoes.todas}</a>
      </p>
    </CabecalhoPagina>

    {
      /* Sumário: as pranchas em miniatura, em ordem de leitura, para pular direto a uma delas. */
      c.mapas.length > 1 && (
        <section class="sumario" aria-labelledby="t-sumario">
          <h2 class="secao" id="t-sumario">{tx.colecoes.sumario}</h2>
          <ol class="sumario__grade" role="list">
            {c.mapas.map((m, n) => (
              <li>
                <a href={linkMapa(m)}>
                  <span class="sumario__capa">
                    <Image
                      src={m.data.imagem}
                      alt=""
                      widths={[200, 320]}
                      sizes="(min-width: 700px) 170px, 45vw"
                      loading={n < 4 ? 'eager' : 'lazy'}
                      format="webp"
                      quality={70}
                    />
                  </span>
                  <span class="rotulo">{tx.geral.no} {numeroFormatado(m.data.numero)}</span>
                  <span class="sumario__titulo">{m.data.titulo}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </div>
  <ListaFeed mapas={c.mapas} />
  <PainelFichas slot="direita" mapas={c.mapas} />
</Base>

<style>
  .sumario {
    margin-top: var(--e-6);
    margin-bottom: var(--e-7);
  }
  .sumario__grade {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(46%, 160px), 1fr));
    gap: var(--e-4) var(--e-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sumario__grade a {
    display: grid;
    gap: 2px;
    text-decoration: none;
    color: var(--tinta);
  }
  .sumario__capa {
    display: block;
    margin-bottom: var(--e-1);
    padding: 3px;
    border: 1px solid var(--linha-fina);
    background: var(--folha);
    transition: border-color 120ms linear;
  }
  .sumario__capa :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: #fff;
  }
  .sumario__grade a:hover .sumario__capa,
  .sumario__grade a:focus-visible .sumario__capa {
    border-color: var(--acento);
  }
  .sumario__grade .rotulo {
    margin: 0;
  }
  .sumario__titulo {
    font-family: var(--f-titulo);
    font-size: var(--t-sm);
    line-height: 1.3;
  }
  .sumario__grade a:hover .sumario__titulo {
    color: var(--acento);
  }
  .andamento {
    margin-top: var(--e-5);
    max-width: 420px;
  }
  .andamento .rotulo {
    margin: var(--e-2) 0 0;
  }
  .ordem {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--e-2) var(--e-4);
    margin: var(--e-5) 0 0;
    font-size: var(--t-sm);
    color: var(--tinta-2);
  }
  .ordem a {
    display: inline-flex;
    align-items: center;
    gap: var(--e-1);
    min-height: 24px;
    color: var(--tinta);
    text-decoration: none;
  }
  .ordem a:hover {
    color: var(--acento);
  }
</style>
