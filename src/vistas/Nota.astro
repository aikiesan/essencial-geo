---
/** Uma nota: manchete, linha de data por extenso, linha fina e texto. */
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import Estrela from '../components/Estrela.astro';
import type { Nota } from '../lib/notas';
import { dataExtensa, dataIso, rota, t } from '../i18n';
import { artigoDaNota, jsonLd } from '../lib/metadados';
import { momentoPublicacao } from '../lib/mapas';

interface Props { nota: Nota; maisNova?: Nota; maisAntiga?: Nota }
const { nota, maisNova, maisAntiga } = Astro.props;
const lingua = nota.lingua;
const tx = t(lingua);
const { Content } = await render(nota);
---

<Base titulo={nota.data.titulo} descricao={nota.data.resumo} tipo="article" publicado={momentoPublicacao(nota.data.data)} atualizado={nota.data.atualizado}>
  <script slot="head" type="application/ld+json" set:html={jsonLd(artigoDaNota(nota, Astro.site))} />
  <article class="feed">
    <header class="cab">
      <p class="rotulo cab__sobre">
        <a href={rota(lingua, 'notas')}>{tx.notas.titulo}</a>
        <span aria-hidden="true">/</span>
        <span>{tx.notas.tipos[nota.data.tipo]}</span>
      </p>
      <h1>{nota.data.titulo}</h1>
      <p class="cab__fina">{nota.data.resumo}</p>
      <p class="linha-data">
        <span class="linha-data__rotulo">{tx.cartao.publicado}</span>
        <time datetime={dataIso(nota.data.data)}>{dataExtensa(nota.data.data, lingua)}</time>
        {
          nota.data.atualizado && (
            <>
              <span aria-hidden="true">·</span>
              <span class="linha-data__rotulo">{tx.cartao.atualizadoEm}</span>
              <time datetime={dataIso(nota.data.atualizado)}>{dataExtensa(nota.data.atualizado, lingua)}</time>
            </>
          )
        }
      </p>
    </header>

    <div class="prosa">
      <Content />
    </div>

    <div class="divisor" aria-hidden="true"><Estrela /></div>

    <nav class="vizinhos" aria-label={tx.notas.titulo}>
      {
        maisAntiga ? (
          <a href={rota(lingua, 'notas', maisAntiga.pasta)} rel="prev">
            <span class="rotulo"><Icone nome="voltar" tamanho={11} /> {dataExtensa(maisAntiga.data.data, lingua)}</span>
            <span class="vizinhos__titulo">{maisAntiga.data.titulo}</span>
          </a>
        ) : (
          <a href={rota(lingua, 'notas')}>
            <span class="rotulo"><Icone nome="voltar" tamanho={11} /> {tx.notas.voltar}</span>
          </a>
        )
      }
      {
        maisNova ? (
          <a href={rota(lingua, 'notas', maisNova.pasta)} rel="next" class="vizinhos__dir">
            <span class="rotulo">{dataExtensa(maisNova.data.data, lingua)} <Icone nome="seta" tamanho={11} /></span>
            <span class="vizinhos__titulo">{maisNova.data.titulo}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</Base>

<style>
  .cab {
    padding-bottom: var(--e-4);
    margin-bottom: var(--e-6);
    border-bottom: 1px solid var(--linha);
  }
  .cab__sobre {
    display: flex;
    gap: var(--e-2);
    margin: 0 0 var(--e-3);
  }
  .cab__sobre a {
    color: var(--tinta-2);
  }
  h1 {
    font-size: var(--t-xxl);
  }
  .cab__fina {
    margin: var(--e-3) 0 0;
    font-style: italic;
    font-size: var(--t-lg);
    color: var(--tinta-2);
    max-width: 60ch;
  }
  .linha-data {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--e-2);
    margin: var(--e-4) 0 0;
    font-size: var(--t-sm);
    font-style: italic;
    color: var(--tinta-2);
  }
  .linha-data__rotulo {
    font-family: var(--f-mono);
    font-style: normal;
    font-size: var(--t-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tinta-3);
  }
  .linha-data time {
    display: inline-block;
  }
  .linha-data time::first-letter {
    text-transform: uppercase;
  }
  .vizinhos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--e-4);
  }
  .vizinhos a {
    display: grid;
    gap: var(--e-1);
    padding: var(--e-3);
    border: 1px solid var(--linha-fina);
    text-decoration: none;
  }
  .vizinhos a:hover {
    border-color: var(--linha);
  }
  .vizinhos .rotulo {
    display: inline-flex;
    align-items: center;
    gap: var(--e-1);
  }
  .vizinhos__dir {
    text-align: right;
    justify-items: end;
  }
  .vizinhos__titulo {
    font-family: var(--f-titulo);
    font-size: var(--t-md);
    line-height: 1.25;
  }
</style>
