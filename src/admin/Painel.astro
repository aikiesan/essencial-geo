---
/**
 * Painel de admin: todas as pranchas do atlas (no ar, agendadas e rascunhos), por coleção.
 * Injetado em /admin/ pelo astro.config.mjs (painelAdmin): no `npm run dev`, aberto, e cada cartão
 * abre a página da prancha, que em desenvolvimento existe mesmo antes da data.
 * No build com ADMIN_SENHA, a página sai cifrada (scripts/painel-cifrado.mjs). Como as páginas das
 * agendadas não existem no site publicado, a capa delas abre a prancha no visualizador; a imagem
 * grande (data-grande) também é cifrada e só é baixada e decifrada no clique.
 */
import { Image, getImage } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import Progresso from '../components/Progresso.astro';
import { COLECOES, type ColecaoId } from '../site.config';
import { dataCurta, dataIso, rota } from '../i18n';
import { momentoPublicacao, noAr, numeroFormatado } from '../lib/mapas';

type Status = 'publicada' | 'agendada' | 'rascunho';
interface Grande {
  src: string;
  largura: number;
  altura: number;
}
interface Prancha {
  m: CollectionEntry<'mapas'>;
  status: Status;
  temEn: boolean;
  /** Dias até entrar no ar (só agendadas). */
  faltam?: number;
  /** Só no build: a prancha ainda não tem página no site, então abre no visualizador. */
  visor?: { pt: Grande; en?: Grande };
}

const CIFRADO = !import.meta.env.DEV;
const DIA = 86_400_000;
const agora = new Date();
const traducoes = new Map((await getCollection('traducoes')).map((tr) => [tr.id, tr]));

async function grande(src: ImageMetadata): Promise<Grande> {
  const largura = Math.min(src.width, 2000);
  const img = await getImage({ src, width: largura, format: 'webp', quality: 80 });
  return { src: img.src, largura, altura: Math.round((src.height * largura) / src.width) };
}

const pranchas: Prancha[] = await Promise.all(
  (await getCollection('mapas'))
    .sort((a, b) => a.data.numero - b.data.numero)
    .map(async (m) => {
      const status: Status = m.data.rascunho ? 'rascunho' : noAr(m.data.data, agora) ? 'publicada' : 'agendada';
      const faltam = status === 'agendada' ? Math.ceil((momentoPublicacao(m.data.data).getTime() - agora.getTime()) / DIA) : undefined;
      const imagemEn = traducoes.get(m.id)?.data.imagem;
      const visor =
        CIFRADO && status !== 'publicada'
          ? { pt: await grande(m.data.imagem), en: imagemEn ? await grande(imagemEn) : undefined }
          : undefined;
      return { m, status, temEn: traducoes.has(m.id), faltam, visor };
    }),
);

// Grupos na ordem de leitura do atlas (a menor prancha de cada coleção); as avulsas no fim.
const grupos = new Map<ColecaoId | '', Prancha[]>();
for (const p of pranchas) {
  const id = p.m.data.colecao ?? '';
  grupos.set(id, [...(grupos.get(id) ?? []), p]);
}
const secoes = [...grupos.entries()]
  .sort(([a, pa], [b, pb]) => (a === '' ? 1 : b === '' ? -1 : pa[0].m.data.numero - pb[0].m.data.numero))
  .map(([id, lista]) => ({
    id: id || 'avulsas',
    titulo: id ? COLECOES[id].pt.titulo : 'Pranchas avulsas',
    lista,
    noAr: lista.filter((p) => p.status === 'publicada').length,
    previstas: lista.filter((p) => p.status !== 'rascunho').length,
  }));
const colecoesSemPrancha = (Object.keys(COLECOES) as ColecaoId[]).filter((id) => !grupos.has(id));

// Agenda: próxima saída, até quando há pranchas, dias repetidos e dias vazios no caminho.
const conta = (s: Status) => pranchas.filter((p) => p.status === s).length;
const agendadas = pranchas
  .filter((p) => p.status === 'agendada')
  .sort((a, b) => a.m.data.data.getTime() - b.m.data.data.getTime());
const proxima = agendadas[0];
const ultima = agendadas.at(-1);
const porDia = new Map<string, number[]>();
for (const p of agendadas) {
  const dia = dataIso(p.m.data.data);
  porDia.set(dia, [...(porDia.get(dia) ?? []), p.m.data.numero]);
}
const repetidos = [...porDia.entries()].filter(([, nums]) => nums.length > 1);
const vazios: string[] = [];
if (proxima && ultima) {
  for (let t = proxima.m.data.data.getTime(); t <= ultima.m.data.data.getTime(); t += DIA) {
    const dia = dataIso(new Date(t));
    if (!porDia.has(dia)) vazios.push(dia);
  }
}
/** Atributos do botão que abre a prancha no visualizador (src/scripts/visor.ts). */
const visor = (g: Grande, legenda: string) => ({
  'data-lightbox': true,
  'data-grande': g.src,
  'data-largura': g.largura,
  'data-altura': g.altura,
  'data-legenda': legenda,
});
const curta = (iso: string) => dataCurta(new Date(`${iso}T00:00:00Z`));
const ROTULO: Record<Status, string> = { publicada: 'No ar', agendada: 'Agendada', rascunho: 'Rascunho' };
---

<Base titulo="Painel do atlas" descricao="Todas as pranchas, no ar e agendadas.">
  <div class="painel" data-filtro="todas">
    <CabecalhoPagina
      sobre={CIFRADO ? 'Admin · área com senha' : 'Admin · npm run dev'}
      titulo="Painel do atlas"
      linhaFina={
        CIFRADO
          ? 'Todas as pranchas, no ar e agendadas, por coleção. As no ar abrem a página; as agendadas abrem a prancha no visualizador.'
          : 'Todas as pranchas, no ar e agendadas, por coleção. Cada cartão abre a página da prancha, mesmo antes da data.'
      }
    />

    <dl class="resumo">
      <div><dt class="rotulo">Pranchas</dt><dd class="mono">{pranchas.length}</dd></div>
      <div><dt class="rotulo">No ar</dt><dd class="mono">{conta('publicada')}</dd></div>
      <div><dt class="rotulo">Agendadas</dt><dd class="mono">{conta('agendada')}</dd></div>
      {conta('rascunho') > 0 && <div><dt class="rotulo">Rascunhos</dt><dd class="mono">{conta('rascunho')}</dd></div>}
      {
        proxima && (
          <div>
            <dt class="rotulo">Próxima</dt>
            <dd class="mono">
              Nº {numeroFormatado(proxima.m.data.numero)} · {dataCurta(proxima.m.data.data)}
            </dd>
          </div>
        )
      }
      {
        ultima && (
          <div>
            <dt class="rotulo">Agenda até</dt>
            <dd class="mono">
              {dataCurta(ultima.m.data.data)} · {ultima.faltam} dias
            </dd>
          </div>
        )
      }
    </dl>

    {
      (repetidos.length > 0 || vazios.length > 0) && (
        <ul class="avisos" role="list">
          {repetidos.map(([dia, nums]) => (
            <li>
              <span class="rotulo">Dia repetido</span> {curta(dia)}: Nº {nums.map(numeroFormatado).join(', ')}
            </li>
          ))}
          {vazios.length > 0 && (
            <li>
              <span class="rotulo">Dias sem prancha</span> {vazios.map(curta).join(' · ')}
            </li>
          )}
        </ul>
      )
    }

    <fieldset class="filtro">
      <legend class="rotulo">Mostrar</legend>
      <label><input type="radio" name="filtro" value="todas" checked /> Todas</label>
      <label><input type="radio" name="filtro" value="publicada" /> No ar</label>
      <label><input type="radio" name="filtro" value="agendada" /> Agendadas</label>
    </fieldset>

    <nav class="sumario" aria-label="Coleções">
      {secoes.map((s) => <a href={`#${s.id}`}>{s.titulo}</a>)}
    </nav>

    {
      secoes.map((s) => (
        <section class="grupo" id={s.id} aria-labelledby={`t-${s.id}`} data-tem={[...new Set(s.lista.map((p) => p.status))].join(' ')}>
          <h2 class="secao" id={`t-${s.id}`}>{s.titulo}</h2>
          <div class="grupo__meta">
            <span class="rotulo">
              Nº {numeroFormatado(s.lista[0].m.data.numero)}–{numeroFormatado(s.lista.at(-1)!.m.data.numero)}
            </span>
            {s.id !== 'avulsas' && <Progresso feitos={s.noAr} total={s.previstas} compacto />}
          </div>
          <ul class="grade" role="list">
            {s.lista.map((p, i) => {
              const d = p.m.data;
              return (
                <li class:list={['carta', `carta--${p.status}`]} data-status={p.status}>
                  {p.visor ? (
                    <button type="button" class="carta__capa" {...visor(p.visor.pt, `Nº ${numeroFormatado(d.numero)} — ${d.titulo}`)} aria-label={`Ampliar a prancha: ${d.titulo}`}>
                      <Image src={d.imagem} alt="" width={360} loading={i < 4 ? 'eager' : 'lazy'} format="webp" quality={72} />
                    </button>
                  ) : (
                    <a class="carta__capa" href={rota('pt', 'mapas', p.m.id)} tabindex="-1" aria-hidden="true">
                      <Image src={d.imagem} alt="" width={360} loading={i < 4 ? 'eager' : 'lazy'} format="webp" quality={72} />
                    </a>
                  )}
                  <p class="carta__meta rotulo">
                    <span class="mono">Nº {numeroFormatado(d.numero)}</span>
                    <span class:list={['selo', `selo--${p.status}`]}>{ROTULO[p.status]}</span>
                  </p>
                  <h3 class="carta__titulo">
                    {p.visor ? d.titulo : <a href={rota('pt', 'mapas', p.m.id)}>{d.titulo}</a>}
                  </h3>
                  <p class="carta__data mono">
                    <time datetime={dataIso(d.data)}>{dataCurta(d.data)}</time>
                    {p.faltam !== undefined && <span> · em {p.faltam} {p.faltam === 1 ? 'dia' : 'dias'}</span>}
                  </p>
                  <p class="carta__linguas rotulo">
                    {p.visor ? (
                      <>
                        <button type="button" {...visor(p.visor.pt, `Nº ${numeroFormatado(d.numero)} — ${d.titulo}`)}>Prancha PT</button>
                        {p.visor.en && (
                          <button type="button" {...visor(p.visor.en, `Nº ${numeroFormatado(d.numero)} — ${traducoes.get(p.m.id)?.data.titulo ?? d.titulo}`)}>
                            Prancha EN
                          </button>
                        )}
                      </>
                    ) : (
                      <a href={rota('pt', 'mapas', p.m.id)}>PT</a>
                    )}
                    {!p.temEn ? <span class="falta">sem EN</span> : !p.visor && <a href={rota('en', 'mapas', p.m.id)}>EN</a>}
                  </p>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }

    {
      colecoesSemPrancha.length > 0 && (
        <section class="grupo">
          <h2 class="secao">Coleções sem prancha</h2>
          <p class="mono">{colecoesSemPrancha.map((id) => COLECOES[id].pt.titulo).join(' · ')}</p>
        </section>
      )
    }
  </div>
  {
    CIFRADO && (
      <script is:inline>
        // Prancha cifrada: baixa e decifra no clique, com a chave guardada pela página da senha
        // (scripts/painel-cifrado.mjs), e entrega a imagem ao visualizador como data-src.
        (() => {
          const b64 = (s) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));
          async function chave() {
            if (window.__chavePainel) return window.__chavePainel;
            let bruta = null;
            try {
              bruta = sessionStorage.getItem('essencial-geo:painel-chave');
            } catch {}
            if (!bruta) throw new Error('abra o painel de novo com a senha');
            return (window.__chavePainel = await crypto.subtle.importKey('raw', b64(bruta), 'AES-GCM', false, ['decrypt']));
          }
          document.addEventListener(
            'click',
            async (ev) => {
              const btn = ev.target.closest('[data-cifrada]');
              if (!btn) return;
              ev.preventDefault();
              ev.stopImmediatePropagation();
              if (btn.dataset.carregando) return;
              btn.dataset.carregando = '1';
              try {
                const r = await fetch(btn.dataset.cifrada);
                if (!r.ok) throw new Error(`HTTP ${r.status}`);
                const dados = new Uint8Array(await r.arrayBuffer());
                const claro = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: dados.slice(0, 12) }, await chave(), dados.slice(12));
                btn.dataset.src = URL.createObjectURL(new Blob([claro], { type: 'image/webp' }));
                delete btn.dataset.cifrada;
                btn.click();
              } catch (e) {
                btn.title = `Não foi possível abrir a prancha: ${e.message}`;
              } finally {
                delete btn.dataset.carregando;
              }
            },
            true,
          );
        })();
      </script>
    )
  }
</Base>

<script>
  const painel = document.querySelector<HTMLElement>('.painel');
  document.querySelectorAll<HTMLInputElement>('input[name="filtro"]').forEach((r) =>
    r.addEventListener('change', () => {
      if (painel && r.checked) painel.dataset.filtro = r.value;
    }),
  );
</script>

<style>
  .resumo {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-4) var(--e-6);
    margin: 0 0 var(--e-5);
  }
  .resumo dt {
    margin: 0 0 var(--e-1);
  }
  .resumo dd {
    margin: 0;
    font-size: var(--t-lg);
  }

  .avisos {
    list-style: none;
    margin: 0 0 var(--e-5);
    padding: var(--e-3) var(--e-4);
    border: 1px solid var(--argila);
    font-size: var(--t-sm);
    display: grid;
    gap: var(--e-2);
  }
  .avisos .rotulo {
    color: var(--argila);
    margin-right: var(--e-2);
  }

  .filtro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-2) var(--e-4);
    margin: 0 0 var(--e-4);
    padding: 0;
    border: 0;
  }
  .filtro legend {
    float: left;
    margin-right: var(--e-2);
  }
  .filtro label {
    display: inline-flex;
    align-items: center;
    gap: var(--e-1);
    font-size: var(--t-sm);
    cursor: pointer;
  }

  .sumario {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-1) var(--e-3);
    padding: var(--e-3) 0;
    margin-bottom: var(--e-6);
    border-top: 1px solid var(--linha-fina);
    border-bottom: 1px solid var(--linha-fina);
    font-size: var(--t-sm);
  }

  .grupo {
    margin-bottom: var(--e-7);
    scroll-margin-top: var(--e-7);
  }
  .grupo__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-2) var(--e-4);
    margin: calc(-1 * var(--e-2)) 0 var(--e-4);
  }

  .grade {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: var(--e-5) var(--e-4);
  }
  .carta__capa {
    display: block;
    width: 100%;
    padding: 4px;
    border: 1px solid var(--linha);
    background: var(--folha);
  }
  button.carta__capa {
    cursor: zoom-in;
  }
  [data-carregando] {
    cursor: progress;
    opacity: 0.6;
  }
  .carta--agendada .carta__capa {
    border-color: var(--nilo-tinta);
  }
  .carta--rascunho .carta__capa {
    border-style: dashed;
    border-color: var(--tinta-3);
  }
  .carta__capa:hover {
    border-color: var(--acento);
  }
  .carta__capa :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--linha-fina);
    background: #fff;
  }
  .carta__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--e-2);
    margin: var(--e-2) 0 var(--e-1);
  }
  .carta__titulo {
    font-size: var(--t-md);
    font-weight: 500;
    line-height: 1.3;
    margin: 0;
  }
  .carta__titulo a {
    text-decoration: none;
  }
  .carta__titulo a:hover {
    text-decoration: underline;
    text-decoration-color: var(--acento);
  }
  .carta__data {
    margin: var(--e-1) 0 0;
    font-size: var(--t-xs);
    color: var(--tinta-2);
  }
  .carta__linguas {
    display: flex;
    gap: var(--e-3);
    margin: var(--e-1) 0 0;
  }
  .carta__linguas a {
    color: var(--tinta-2);
  }
  .carta__linguas button {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--tinta-2);
    text-decoration: underline;
    text-decoration-color: var(--linha-fina);
    cursor: zoom-in;
  }
  .falta {
    color: var(--argila);
  }

  .selo {
    padding: 0 var(--e-1);
    border: 1px solid var(--tinta-3);
    color: var(--tinta-2);
    letter-spacing: 0.06em;
  }
  .selo--agendada {
    border-color: var(--nilo-tinta);
    color: var(--nilo-tinta);
  }
  .selo--rascunho {
    border-style: dashed;
  }

  /* Filtro: esconde cartões e coleções sem nenhum cartão do status pedido. */
  .painel[data-filtro='publicada'] .carta:not([data-status='publicada']),
  .painel[data-filtro='agendada'] .carta:not([data-status='agendada']),
  .painel[data-filtro='publicada'] .grupo[data-tem]:not([data-tem~='publicada']),
  .painel[data-filtro='agendada'] .grupo[data-tem]:not([data-tem~='agendada']) {
    display: none;
  }
</style>
