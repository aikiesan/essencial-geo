---
/**
 * Coluna esquerda: o que é o projeto e quem o faz, o próximo mapa, as coleções em
 * andamento, os temas e a nota mais recente. As seções do site ficam na barra do topo.
 * Em telas estreitas a coluna vira o painel do menu e repete as seções no alto.
 */
import Estrela from './Estrela.astro';
import Icone from './Icone.astro';
import Progresso from './Progresso.astro';
import { AUTOR, CATEGORIA_IDS, LINKS, SITE, type CategoriaId } from '../site.config';
import { contarPorCategoria, mapasPublicados, proximaPublicacao } from '../lib/mapas';
import { colecoesNoAr } from '../lib/colecoes';
import { notasPublicadas } from '../lib/notas';
import { dataCurta, dataExtensa, dataIso, linguaDe, rota, t, url } from '../i18n';

interface Props {
  /** Categoria ativa (undefined = nenhuma; 'todas' = feed). */
  categoriaAtiva?: CategoriaId | 'todas';
}
const { categoriaAtiva } = Astro.props;
const lingua = linguaDe(Astro.url.pathname);
const tx = t(lingua);
const b = tx.barra;
const n = tx.topo;

const mapas = await mapasPublicados(lingua);
const contagem = contarPorCategoria(mapas);
const proxima = await proximaPublicacao();
const ultimaNota = (await notasPublicadas(lingua))[0];
const series = await colecoesNoAr(lingua);
const temas = CATEGORIA_IDS.filter((id) => contagem[id] > 0);

const caminho = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const comeca = (destino: string) => caminho.startsWith(destino);
// As mesmas seções do topo, para o menu em telas estreitas.
const secoes = [
  { icone: 'casa', rotulo: n.mapas, href: rota(lingua), ativo: categoriaAtiva !== undefined || comeca(rota(lingua, 'mapas')) },
  { icone: 'colecoes', rotulo: n.colecoes, href: rota(lingua, 'colecoes'), ativo: comeca(rota(lingua, 'colecoes')) },
  { icone: 'lista', rotulo: n.indice, href: rota(lingua, 'indice'), ativo: comeca(rota(lingua, 'indice')) },
  { icone: 'nota', rotulo: n.notas, href: rota(lingua, 'notas'), ativo: comeca(rota(lingua, 'notas')) },
  { icone: 'info', rotulo: n.sobre, href: rota(lingua, 'sobre'), ativo: comeca(rota(lingua, 'sobre')) },
] as const;

const p = b.perfis;
const perfis = [
  { rotulo: p.lattes, href: LINKS.lattes },
  { rotulo: p.orcid, href: LINKS.orcid },
  { rotulo: p.scholar, href: LINKS.scholar },
  { rotulo: p.github, href: LINKS.github },
  { rotulo: p.zenodo, href: LINKS.zenodo },
  { rotulo: p.fapesp, href: LINKS.fapesp },
  { rotulo: p.unicamp, href: LINKS.unicamp },
];
const autor = AUTOR[lingua];
const iniciais = AUTOR.nomeCompleto
  .split(' ')
  .filter((_, i, a) => i === 0 || i === a.length - 1)
  .map((s) => s[0])
  .join('');
---

<aside class="esq" id="col-esq" data-esq aria-label={b.projeto}>
  <nav class="secoes" aria-label={n.navegacao}>
    <ul role="list">
      {
        secoes.map((s) => (
          <li>
            <a href={s.href} aria-current={s.ativo ? 'page' : undefined}>
              <Icone nome={s.icone} tamanho={16} />
              {s.rotulo}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <section class="projeto" aria-labelledby="t-projeto">
    <h2 class="secao" id="t-projeto">{b.projeto}</h2>
    <p class="projeto__lema">{tx.site.slogan}</p>
    <p class="projeto__texto">{b.objetivo}</p>
    {
      proxima && (
        <p class="proximo">
          <Estrela tamanho={10} />
          <span class="proximo__rotulo">{b.proximoMapa}</span>
          <time datetime={dataIso(proxima)}>{dataExtensa(proxima, lingua).replace(/,? de \d{4}$| \d{4}$/, '')}</time>
        </p>
      )
    }
  </section>

  <section class="autor" aria-labelledby="t-autor-barra">
    <h2 class="secao" id="t-autor-barra">{b.quemFaz}</h2>
    <div class="autor__cabeca">
      <span class="autor__monograma" aria-hidden="true">{iniciais}</span>
      <div>
        <p class="autor__nome">{AUTOR.nomeCompleto}</p>
        <p class="autor__funcao">{autor.funcao.split(' · ')[0]}</p>
      </div>
    </div>
    <p class="autor__resumo">{b.autorResumo}</p>
    <ul class="perfis" role="list">
      {
        perfis.map((l) => (
          <li>
            <a href={l.href} rel="noopener me">{l.rotulo}</a>
          </li>
        ))
      }
    </ul>
    <a class="autor__mais" href={`${rota(lingua, 'sobre')}#t-autor`}>
      {b.maisAutor} <Icone nome="seta" tamanho={12} />
    </a>
  </section>

  {
    series.length > 0 && (
      <section aria-labelledby="t-colecoes">
        <h2 class="secao" id="t-colecoes">{b.colecoes}</h2>
        <ul class="series" role="list">
          {series.map((c) => (
            <li>
              <a href={rota(lingua, 'colecoes', c.id)} aria-current={comeca(rota(lingua, 'colecoes', c.id)) ? 'page' : undefined}>
                <span class="series__titulo">{c.titulo}</span>
                <Progresso feitos={c.mapas.length} total={Math.max(c.ordem.length, c.mapas.length)} compacto />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    temas.length > 0 && (
      <nav aria-labelledby="t-temas">
        <h2 class="secao" id="t-temas">{b.temas}</h2>
        <ul class="temas" role="list">
          {temas.map((id) => (
            <li>
              <a href={rota(lingua, 'categoria', id)} aria-current={categoriaAtiva === id ? 'page' : undefined}>
                {tx.categorias[id].curto} <span class="mono">{contagem[id]}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  {
    ultimaNota && (
      <section aria-labelledby="t-nota" class="nota-recente">
        <h2 class="secao" id="t-nota">{b.notas}</h2>
        <a href={rota(lingua, 'notas', ultimaNota.pasta)}>
          <time class="rotulo" datetime={dataIso(ultimaNota.data.data)}>{dataCurta(ultimaNota.data.data, lingua)}</time>
          <span class="nota-recente__titulo">{ultimaNota.data.titulo}</span>
        </a>
      </section>
    )
  }

  <footer class="esq__pe">
    <span class="meandro esq__meandro" aria-hidden="true"></span>
    <p class="colofao rotulo">
      <a href={SITE.licenca.url[lingua]} rel="license noopener">{SITE.licenca.nome}</a> · {tx.site.cadencia} ·
      <a href={url(lingua === 'en' ? 'en/rss.xml' : 'rss.xml')}>RSS</a><br />
      <Estrela tamanho={9} /> {tx.site.colofao}<br />
      22°49′S · 47°04′W · SIRGAS 2000
    </p>
  </footer>
</aside>

<style>
  .esq {
    display: flex;
    flex-direction: column;
    gap: var(--e-6);
    padding: var(--e-5) var(--e-4) var(--e-5);
    background: var(--painel);
  }
  .esq > section,
  .esq > nav {
    margin: 0;
  }

  /* Seções do site: só no menu de telas estreitas (no desktop estão no topo) */
  .secoes ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .secoes a {
    display: flex;
    align-items: center;
    gap: var(--e-3);
    min-height: 44px;
    padding: 0 var(--e-3);
    margin: 0 calc(-1 * var(--e-3));
    font-size: var(--t-lg);
    text-decoration: none;
    color: var(--tinta);
  }
  .secoes a :global(.icone) {
    color: var(--tinta-3);
  }
  .secoes a[aria-current='page'] {
    background: var(--trigo);
  }
  @media (min-width: 860px) {
    .secoes {
      display: none;
    }
  }

  /* O projeto: o lema em itálico e uma frase clara sobre o objetivo */
  .projeto__lema {
    margin: 0 0 var(--e-2);
    font-family: var(--f-titulo);
    font-style: italic;
    font-size: 1.1875rem;
    line-height: 1.3;
  }
  .projeto__texto {
    margin: 0;
    font-size: var(--t-sm);
    line-height: 1.65;
    color: var(--tinta-2);
  }
  .proximo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-1) var(--e-2);
    margin: var(--e-4) 0 0;
    padding: var(--e-2) var(--e-3);
    background: var(--papel);
    font-size: var(--t-sm);
  }
  .proximo__rotulo {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tinta-3);
  }
  .proximo time {
    font-style: italic;
  }
  .proximo time::first-letter {
    text-transform: uppercase;
  }

  /* Quem faz: monograma, nome, função e os perfis acadêmicos à vista */
  .autor {
    padding: var(--e-4);
    margin-inline: calc(-1 * var(--e-2)) !important;
    border: 1px solid var(--linha-fina);
    background: var(--papel);
  }
  .autor__cabeca {
    display: flex;
    align-items: center;
    gap: var(--e-3);
  }
  .autor__cabeca p {
    margin: 0;
  }
  .autor__monograma {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    background: var(--trigo);
    box-shadow: inset 0 0 0 1px var(--cesto, var(--linha-fina));
    font-family: var(--f-titulo);
    font-style: italic;
    font-size: 1.0625rem;
    letter-spacing: 0.04em;
    color: var(--tinta);
  }
  .autor__nome {
    font-family: var(--f-titulo);
    font-size: var(--t-md);
    line-height: 1.2;
  }
  .autor__funcao {
    margin-top: 2px !important;
    font-size: var(--t-xs);
    line-height: 1.4;
    color: var(--tinta-3);
  }
  .autor__resumo {
    margin: var(--e-3) 0;
    font-size: var(--t-sm);
    line-height: 1.6;
    color: var(--tinta-2);
  }
  .perfis {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 var(--e-3);
    padding: 0;
    list-style: none;
  }
  .perfis a {
    display: inline-block;
    padding: 3px 9px;
    border: 1px solid var(--linha-fina);
    background: var(--painel);
    font-size: var(--t-xs);
    color: var(--tinta-2);
    text-decoration: none;
    transition:
      border-color 120ms ease,
      color 120ms ease;
  }
  .perfis a:hover {
    border-color: var(--acento);
    color: var(--acento);
  }
  .autor__mais {
    display: inline-flex;
    align-items: center;
    gap: var(--e-1);
    font-size: var(--t-sm);
    color: var(--acento);
    text-decoration: none;
  }
  .autor__mais:hover {
    text-decoration: underline;
  }

  /* Coleções em andamento */
  .series,
  .temas {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .series li + li {
    margin-top: var(--e-2);
  }
  .series a {
    display: grid;
    gap: var(--e-2);
    padding: var(--e-3);
    border: 1px solid var(--linha-fina);
    text-decoration: none;
    transition: border-color 120ms linear;
  }
  .series a:hover {
    border-color: var(--tinta-3);
  }
  .series a[aria-current='page'] {
    border-color: var(--linha);
    background: var(--papel);
  }
  .series__titulo {
    font-family: var(--f-titulo);
    font-size: var(--t-md);
    line-height: 1.25;
  }

  /* Temas: etiquetas */
  .temas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2);
  }
  .temas a {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    min-height: 30px;
    padding: 0 var(--e-3);
    border: 1px solid var(--linha-fina);
    font-size: var(--t-sm);
    text-decoration: none;
  }
  .temas a:hover {
    border-color: var(--tinta-3);
  }
  .temas a[aria-current='page'] {
    background: var(--trigo);
    border-color: var(--trigo);
  }
  .temas .mono {
    font-size: var(--t-xs);
    color: var(--tinta-3);
  }

  /* Última nota: uma manchete curta, como o "último minuto" de um jornal */
  .nota-recente a {
    display: grid;
    gap: var(--e-1);
    padding: var(--e-3);
    border: 1px solid var(--linha-fina);
    border-left: 3px solid var(--nilo);
    text-decoration: none;
  }
  .nota-recente a:hover {
    border-color: var(--tinta-3);
    border-left-color: var(--nilo);
  }
  .nota-recente time {
    margin: 0;
  }
  .nota-recente__titulo {
    font-family: var(--f-titulo);
    font-size: var(--t-md);
    line-height: 1.25;
  }

  .esq__pe {
    margin-top: auto;
  }
  .esq__meandro {
    margin-bottom: var(--e-4);
  }
  .colofao {
    margin: 0;
    line-height: 1.7;
  }
  .colofao a {
    color: inherit;
  }
</style>
