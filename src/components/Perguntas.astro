---
/**
 * Entrada por pergunta: cada pergunta abre as coleções que a respondem, em ordem de leitura.
 * Só aparecem coleções no ar; uma pergunta sem nenhuma fica de fora.
 */
import Icone from './Icone.astro';
import type { Colecao } from '../lib/colecoes';
import { PERGUNTAS } from '../lib/guia';
import { linguaDe, rota, t } from '../i18n';

interface Props { series: Colecao[] }
const { series } = Astro.props;
const lingua = linguaDe(Astro.url.pathname);
const tx = t(lingua);
const porId = new Map(series.map((c) => [c.id, c]));
const perguntas = PERGUNTAS.map((p) => ({
  ...p,
  respostas: p.colecoes.map((id) => porId.get(id)).filter((c): c is Colecao => Boolean(c)),
})).filter((p) => p.respostas.length > 0);
---

<ol class="perguntas" role="list">
  {
    perguntas.map((p, n) => (
      <li class="pergunta">
        <p class="pergunta__n mono" aria-hidden="true">
          {String(n + 1).padStart(2, '0')}
        </p>
        <h3 class="pergunta__texto">{p.pergunta[lingua]}</h3>
        <ul class="pergunta__respostas" role="list">
          {p.respostas.map((c) => (
            <li>
              <a href={rota(lingua, 'colecoes', c.id)}>
                <span class="pergunta__colecao">{c.titulo}</span>
                <span class="pergunta__qtd mono">
                  {c.mapas.length} {tx.inicio.pranchas}
                </span>
                <Icone nome="seta" tamanho={11} />
              </a>
            </li>
          ))}
        </ul>
      </li>
    ))
  }
</ol>

<style>
  .perguntas {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--linha);
    border-left: 1px solid var(--linha-fina);
  }
  .pergunta {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: var(--e-2);
    padding: var(--e-4) var(--e-4) var(--e-3);
    border-right: 1px solid var(--linha-fina);
    border-bottom: 1px solid var(--linha-fina);
  }
  /* Marca de canto, como os cantos de corte de uma prancha */
  .pergunta::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    width: 10px;
    height: 10px;
    border-top: 1px solid var(--cesto);
    border-left: 1px solid var(--cesto);
    transition:
      width 200ms ease,
      height 200ms ease;
  }
  .pergunta:hover::before,
  .pergunta:focus-within::before {
    width: 28px;
    height: 28px;
  }
  .pergunta__n {
    margin: 0;
    font-size: var(--t-xs);
    color: var(--tinta-3);
  }
  .pergunta__texto {
    font-size: var(--t-lg);
    line-height: 1.25;
    font-style: italic;
  }
  .pergunta__respostas {
    align-self: end;
    margin: var(--e-2) 0 0;
    padding: 0;
    list-style: none;
  }
  .pergunta__respostas a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--e-2);
    min-height: 32px;
    padding: var(--e-1) 0;
    border-top: 1px solid var(--linha-fina);
    font-size: var(--t-sm);
    line-height: 1.3;
    text-decoration: none;
    color: var(--tinta);
  }
  .pergunta__respostas a:hover .pergunta__colecao {
    color: var(--acento);
  }
  .pergunta__respostas :global(svg) {
    color: var(--tinta-3);
    transition: transform 160ms ease;
  }
  .pergunta__respostas a:hover :global(svg) {
    transform: translateX(3px);
    color: var(--acento);
  }
  .pergunta__qtd {
    font-size: var(--t-xs);
    color: var(--tinta-3);
    white-space: nowrap;
  }
</style>
