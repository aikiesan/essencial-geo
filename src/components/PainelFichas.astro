---
/**
 * Conteúdo da gaveta da ficha: uma ficha por mapa da página; o botão
 * "Ficha, downloads e citação" de cada cartão mostra só a sua.
 */
import Ficha from './Ficha.astro';
import { SITE } from '../site.config';
import type { Mapa } from '../lib/mapas';
import { linguaDe, t } from '../i18n';

interface Props { mapas: Mapa[] }
const { mapas } = Astro.props;
const lingua = linguaDe(Astro.url.pathname);
const tx = t(lingua);
const [antes, depois] = tx.feed.licencaPainel.split('{licenca}');
---

<div class="painel">
  {
    mapas.map((m, i) => (
      <div data-ficha-de={m.id} hidden={i !== 0}>
        <Ficha mapa={m} cabecalho />
      </div>
    ))
  }
  <p class="painel__licenca rotulo">
    {antes}<a href={SITE.licenca.url[lingua]} rel="license noopener">{SITE.licenca.nome}</a>{depois}
  </p>
</div>

<style>
  .painel {
    padding: var(--e-5) var(--e-5) var(--e-6);
  }
  .painel__licenca {
    margin: var(--e-6) 0 0;
    padding-top: var(--e-3);
    border-top: 1px solid var(--linha-fina);
    text-transform: none;
    letter-spacing: 0.02em;
    line-height: 1.6;
  }
</style>
