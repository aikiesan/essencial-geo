---
/**
 * Marca: um pequeno asteroide com graticulado — o planeta do principezinho
 * desenhado como um globo cartográfico — e uma estrela ao lado.
 */
interface Props { tamanho?: number }
const { tamanho = 40 } = Astro.props;
---
<svg class="logo" width={tamanho} height={tamanho} viewBox="0 0 48 48" aria-hidden="true">
  <g fill="none" stroke="currentColor" stroke-width="1">
    <circle cx="21" cy="27" r="15.5" />
    <ellipse cx="21" cy="27" rx="6.5" ry="15.5" />
    <path d="M5.5 27h31M8 19h26M8 35h26" stroke-width=".75" />
    <path d="M21 11.5v31" stroke-width=".75" />
  </g>
  <path
    fill="var(--estrela)"
    d="M40 3.2l1.38 3.26 3.52.29-2.67 2.31.8 3.44L40 10.66l-3.03 1.84.8-3.44-2.67-2.31 3.52-.29z"
  />
</svg>
