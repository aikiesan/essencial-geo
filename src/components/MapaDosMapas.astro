---
/**
 * O mapa dos mapas: o Brasil desenhado no build (d3-geo, Albers), cada UF tingida pelo número de
 * pranchas cujo recorte cai nela, e uma lupa sobre São Paulo com uma caixa (ou um ponto) por recorte
 * menor que o estado. Tudo é SVG estático com links: sem JavaScript, funciona igual.
 * A malha vem de src/data/brasil-ufs.json (scripts/site-malha-ufs.mjs).
 */
import { geoArea, geoConicEqualArea, geoGraticule, geoPath } from 'd3-geo';
import Icone from './Icone.astro';
import { escopoDoMapa, linkMapa, type Mapa } from '../lib/mapas';
import { CAIXAS_SP, ufDoRecorte } from '../lib/guia';
import { linguaDe, rota, t } from '../i18n';
import malha from '../data/brasil-ufs.json';

interface Props { mapas: Mapa[] }
const { mapas } = Astro.props;
const lingua = linguaDe(Astro.url.pathname);
const tx = t(lingua);
const i = tx.inicio;
const plural = (n: number) => `${n} ${n === 1 ? tx.colecoes.mapa : tx.colecoes.mapas}`;

const porUf = new Map<string, Mapa[]>();
for (const m of mapas) {
  if (escopoDoMapa(m) === 'brasil') continue;
  const uf = ufDoRecorte(m.original.recorte);
  if (uf) porUf.set(uf, [...(porUf.get(uf) ?? []), m]);
}
const oeste = lingua === 'en' ? 'W' : 'O';
const brasil = mapas.filter((m) => escopoDoMapa(m) === 'brasil').length;
const maior = Math.max(1, ...[...porUf.values()].map((l) => l.length));
// Escala logarítmica: São Paulo tem dezenas de pranchas, os outros estados uma ou duas.
const peso = (n: number) => (n ? 0.32 + 0.58 * (Math.log1p(n) / Math.log1p(maior)) : 0);

const semAcento = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
const galeria = (busca: string) => `${rota(lingua)}?${busca}#galeria`;
const destinoUf = (uf: string, lista: Mapa[]) =>
  lista.length === 1 ? linkMapa(lista[0]) : uf === 'SP' ? galeria('recorte=sp') : galeria(`q=${uf.toLowerCase()}`);

// d3-geo quer anéis no sentido horário; a malha do IBGE vem no anti-horário (RFC 7946).
type Feicao = (typeof malha.features)[number];
const ufs: Feicao[] = malha.features.map((f) =>
  geoArea(f as never) > 2 * Math.PI
    ? {
        ...f,
        geometry: { ...f.geometry, coordinates: f.geometry.coordinates.map((p) => p.map((a) => [...a].reverse())) },
      }
    : f,
);
const colecao = { type: 'FeatureCollection', features: ufs } as never;

const L = 520;
const A = 500;
const projecao = geoConicEqualArea()
  .parallels([-2, -22])
  .rotate([54, 0])
  .fitExtent([[18, 18], [L - 18, A - 18]], colecao);
const caminho = geoPath(projecao).digits(1);
const graticula = caminho(geoGraticule().step([5, 5]).extent([[-80, -40], [-30, 10]])()) ?? '';
const contorno = caminho(colecao) ?? '';

// Rótulos só onde a UF tem área para eles; as pequenas ficam com a dica (title) e o leitor de tela.
const PEQUENAS = new Set(['DF', 'SE', 'AL', 'PB', 'RN', 'ES', 'RJ', 'PE']);
const estados = ufs.map((f) => {
  const uf = f.properties.uf;
  const lista = porUf.get(uf) ?? [];
  const [x, y] = projecao(f.properties.rotulo as [number, number]) ?? [0, 0];
  return { uf, lista, d: caminho(f as never) ?? '', x, y, rotulo: !PEQUENAS.has(uf) };
});
const sp = ufs.find((f) => f.properties.uf === 'SP')!;
const [[spx0, spy0], [spx1, spy1]] = caminho.bounds(sp as never);

// A lupa: São Paulo sozinho, com os recortes menores numerados.
const LL = 340;
const LA = 230;
const recortesSp = new Map<string, Mapa[]>();
for (const m of porUf.get('SP') ?? []) {
  if (/^Estado de São Paulo/.test(m.original.recorte)) continue;
  recortesSp.set(m.original.recorte, [...(recortesSp.get(m.original.recorte) ?? []), m]);
}
// A lupa enquadra as caixas dos recortes que estão no ar (com folga), não o estado inteiro.
const caixasNoAr = [...recortesSp.keys()]
  .map((r) => CAIXAS_SP.find((c) => c.padrao.test(r))?.caixa)
  .filter((c): c is [number, number, number, number] => Boolean(c));
const FOLGA = 0.5;
const enquadra = caixasNoAr.length
  ? [
      Math.min(...caixasNoAr.map((c) => c[0])) - FOLGA,
      Math.min(...caixasNoAr.map((c) => c[1])) - FOLGA,
      Math.max(...caixasNoAr.map((c) => c[2])) + FOLGA,
      Math.max(...caixasNoAr.map((c) => c[3])) + FOLGA,
    ]
  : [-53.2, -25.4, -44.1, -19.7];
const lupa = geoConicEqualArea()
  .parallels([-21, -24])
  .rotate([48.5, 0])
  .fitExtent([[10, 10], [LL - 10, LA - 22]], {
    type: 'MultiPoint',
    coordinates: [[enquadra[0], enquadra[1]], [enquadra[2], enquadra[3]], [enquadra[0], enquadra[3]], [enquadra[2], enquadra[1]]],
  } as never);
const caminhoLupa = geoPath(lupa).digits(1);
type Forma = { tipo: 'ponto' | 'caixa'; d?: string; x: number; y: number };
const subrecortes = [...recortesSp]
  .sort((a, b) => b[1].length - a[1].length)
  .map(([original, lista], n) => {
    const caixa = CAIXAS_SP.find((c) => c.padrao.test(original));
    const nome = lista[0].data.recorte.replace(/\s*\(SP\)$/, '');
    const href =
      lista.length === 1 ? linkMapa(lista[0]) : galeria(`q=${encodeURIComponent(semAcento(lista[0].data.recorte))}`);
    let forma: Forma | undefined;
    if (caixa) {
      const [o, s, l, nn] = caixa.caixa;
      if (caixa.ponto) {
        const [x, y] = lupa([o, s]) ?? [0, 0];
        forma = { tipo: 'ponto', x, y };
      } else {
        const cantos = [[o, nn], [l, nn], [l, s], [o, s]].map((c) => lupa(c as [number, number]) ?? [0, 0]);
        forma = {
          tipo: 'caixa',
          d: `M${cantos.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join('L')}Z`,
          x: cantos[0][0],
          y: cantos[0][1],
        };
      }
    }
    return { n: n + 1, nome, lista, href, forma };
  });
---

<figure class="mdm">
  <div class="mdm__quadro">
    <span class="mdm__tique mdm__tique--n mono" aria-hidden="true">5° N</span>
    <span class="mdm__tique mdm__tique--s mono" aria-hidden="true">33° S</span>
    <span class="mdm__tique mdm__tique--o mono" aria-hidden="true">74° {oeste}</span>
    <span class="mdm__tique mdm__tique--l mono" aria-hidden="true">35° {oeste}</span>
    <svg class="mdm__mapa" viewBox={`0 0 ${L} ${A}`} role="group" aria-label={i.mapaDosMapas}>
      <path class="mdm__graticula" d={graticula} aria-hidden="true" />
      {
        estados.map((e) =>
          e.lista.length ? (
            <a class="mdm__uf--com" href={destinoUf(e.uf, e.lista)} aria-label={`${e.uf}: ${plural(e.lista.length)}`}>
              <title>{`${e.uf} · ${plural(e.lista.length)}`}</title>
              <path d={e.d} style={`--peso:${peso(e.lista.length).toFixed(2)}`} />
            </a>
          ) : (
            <path class="mdm__uf" d={e.d}>
              <title>{`${e.uf} · ${i.semMapa}`}</title>
            </path>
          ),
        )
      }
      <path class="mdm__contorno" d={contorno} aria-hidden="true" />
      <g class="mdm__rotulos" aria-hidden="true">
        {
          estados
            .filter((e) => e.rotulo)
            .map((e) => (
              <text x={e.x} y={e.y} class:list={['mdm__rotulo', e.lista.length > 0 && 'mdm__rotulo--com']}>
                <tspan x={e.x}>{e.uf}</tspan>
                {e.lista.length > 0 && (
                  <tspan x={e.x} dy="11" class="mdm__conta">
                    {e.lista.length}
                  </tspan>
                )}
              </text>
            ))
        }
      </g>
      {
        subrecortes.length > 0 && (
          <rect
            class="mdm__alvo"
            x={spx0 - 4}
            y={spy0 - 4}
            width={spx1 - spx0 + 8}
            height={spy1 - spy0 + 8}
            aria-hidden="true"
          />
        )
      }
    </svg>
  </div>

  <figcaption class="mdm__legenda">
    <a class="mdm__brasil" href={galeria('recorte=brasil')}>
      <span class="rotulo">{i.brasilInteiro}</span>
      <span class="mdm__total">{brasil}</span>
      <span class="rotulo">{tx.colecoes.mapas} <Icone nome="seta" tamanho={11} /></span>
    </a>
    {
      subrecortes.length > 0 && (
        <div class="mdm__sp">
          <p class="rotulo">{i.dentroSp}</p>
          <svg class="mdm__lupa" viewBox={`0 0 ${LL} ${LA}`} role="group" aria-label={i.lupaSp}>
            <path class="mdm__uf--lupa" d={caminhoLupa(sp as never) ?? ''} aria-hidden="true" />
            {subrecortes
              .filter((r) => r.forma)
              .map((r) => (
                <a href={r.href} class="mdm__recorte" aria-label={`${r.nome}: ${plural(r.lista.length)}`}>
                  <title>{`${r.nome} · ${plural(r.lista.length)}`}</title>
                  {r.forma!.tipo === 'caixa' ? <path d={r.forma!.d} /> : <circle cx={r.forma!.x} cy={r.forma!.y} r="4.5" />}
                  <text
                    x={r.forma!.x + (r.forma!.tipo === 'ponto' ? 7 : 3)}
                    y={r.forma!.y + (r.forma!.tipo === 'ponto' ? -5 : 10)}
                  >
                    {r.n}
                  </text>
                </a>
              ))}
            <text class="mdm__lupa-rotulo" x="10" y={LA - 8} aria-hidden="true">
              {i.lupaSp}
            </text>
          </svg>
          <ol role="list">
            {subrecortes.map((r) => (
              <li>
                <a href={r.href}>
                  <span class="mdm__num mono" aria-hidden="true">
                    {r.n}
                  </span>
                  <span>{r.nome}</span>
                  <span class="mono">{r.lista.length}</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      )
    }
    <p class="mdm__chave rotulo">
      <span class="mdm__amostra mdm__amostra--com" aria-hidden="true"></span>
      {tx.colecoes.mapas}
      <span class="mdm__amostra" aria-hidden="true"></span>
      {i.semMapa}
    </p>
    <p class="mdm__fonte mono">{i.malhaFonte}</p>
  </figcaption>
</figure>

<style>
  .mdm {
    display: grid;
    gap: var(--e-5);
    margin: 0;
    align-items: start;
  }
  @media (min-width: 900px) {
    .mdm {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: var(--e-6);
    }
  }
  /* Moldura de prancha com tiques de coordenadas em volta do Brasil */
  .mdm__quadro {
    position: relative;
    padding: var(--e-3);
    border: 1px solid var(--linha);
    background: var(--folha);
  }
  .mdm__mapa,
  .mdm__lupa {
    display: block;
    width: 100%;
    height: auto;
  }
  .mdm__tique {
    position: absolute;
    font-size: 10px;
    color: var(--tinta-3);
    background: var(--folha);
    padding: 0 3px;
    line-height: 1;
  }
  .mdm__tique--n {
    top: -6px;
    left: var(--e-4);
  }
  .mdm__tique--s {
    bottom: -6px;
    right: var(--e-4);
  }
  .mdm__tique--o {
    left: -1px;
    bottom: var(--e-4);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    padding: 3px 0;
  }
  .mdm__tique--l {
    right: -1px;
    top: var(--e-4);
    writing-mode: vertical-rl;
    padding: 3px 0;
  }
  .mdm__graticula {
    fill: none;
    stroke: var(--linha-fina);
    stroke-width: 0.6;
  }
  .mdm__uf {
    fill: var(--folha);
    stroke: var(--linha);
    stroke-width: 0.5;
    stroke-dasharray: 2 2;
  }
  .mdm__uf--com path {
    fill: var(--trigo);
    fill-opacity: var(--peso);
    stroke: var(--tinta-2);
    stroke-width: 0.6;
    transition:
      fill 120ms linear,
      fill-opacity 120ms linear;
  }
  .mdm__uf--com:hover path,
  .mdm__uf--com:focus-visible path {
    fill: var(--tinta);
    fill-opacity: 1;
  }
  .mdm__uf--com:focus-visible,
  .mdm__recorte:focus-visible {
    outline: none;
  }
  .mdm__uf--com:focus-visible path {
    stroke: var(--acento);
    stroke-width: 2;
  }
  .mdm__contorno {
    fill: none;
    stroke: var(--tinta);
    stroke-width: 1;
    pointer-events: none;
  }
  .mdm__rotulos {
    pointer-events: none;
  }
  .mdm__rotulo {
    font-family: var(--f-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    text-anchor: middle;
    fill: var(--tinta-3);
  }
  .mdm__rotulo--com {
    fill: var(--tinta);
    font-weight: 600;
  }
  .mdm__conta {
    font-weight: 400;
  }
  .mdm__alvo {
    fill: none;
    stroke: var(--cesto);
    stroke-width: 1;
    stroke-dasharray: 3 2;
    pointer-events: none;
  }
  .mdm__legenda {
    display: grid;
    gap: var(--e-4);
    align-content: start;
  }
  .mdm__brasil {
    display: grid;
    justify-items: start;
    gap: var(--e-1);
    padding: var(--e-3) var(--e-4);
    border: 1px solid var(--linha);
    text-decoration: none;
    color: var(--tinta);
    max-width: 260px;
  }
  .mdm__brasil:hover {
    border-color: var(--acento);
  }
  .mdm__brasil .rotulo {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--e-1);
  }
  .mdm__total {
    font-family: var(--f-titulo);
    font-size: var(--t-xxl);
    line-height: 1;
  }
  .mdm__sp .rotulo {
    margin: 0 0 var(--e-2);
  }
  .mdm__lupa {
    max-width: 420px;
    margin-bottom: var(--e-3);
    border: 1px dashed var(--cesto);
    background: var(--folha);
  }
  .mdm__uf--lupa {
    fill: var(--folha);
    stroke: var(--tinta-2);
    stroke-width: 0.8;
  }
  .mdm__recorte path,
  .mdm__recorte circle {
    fill: var(--trigo);
    fill-opacity: 0.12;
    stroke: var(--tinta);
    stroke-width: 0.8;
  }
  .mdm__recorte circle {
    fill-opacity: 1;
  }
  .mdm__recorte text,
  .mdm__lupa-rotulo {
    font-family: var(--f-mono);
    font-size: 10px;
    fill: var(--tinta);
  }
  .mdm__lupa-rotulo {
    fill: var(--tinta-3);
    letter-spacing: 0.06em;
  }
  /* halo de papel para os números e o rótulo não se perderem sobre as linhas */
  .mdm__recorte text,
  .mdm__lupa-rotulo,
  .mdm__rotulo {
    paint-order: stroke;
    stroke: var(--folha);
    stroke-width: 3px;
    stroke-linejoin: round;
  }
  .mdm__recorte:hover path,
  .mdm__recorte:focus-visible path,
  .mdm__recorte:hover circle,
  .mdm__recorte:focus-visible circle {
    fill: var(--tinta);
    fill-opacity: 0.25;
    stroke: var(--acento);
    stroke-width: 1.6;
  }
  .mdm__sp ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--linha-fina);
  }
  .mdm__sp ol a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--e-3);
    min-height: 24px;
    padding: var(--e-1) 0;
    border-bottom: 1px solid var(--linha-fina);
    font-size: var(--t-sm);
    line-height: 1.4;
    text-decoration: none;
    color: var(--tinta);
  }
  .mdm__sp ol a:hover {
    color: var(--acento);
  }
  .mdm__sp .mono {
    font-size: var(--t-xs);
    color: var(--tinta-3);
  }
  .mdm__num {
    display: inline-grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border: 1px solid var(--linha);
  }
  .mdm__chave {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-2);
    margin: 0;
  }
  .mdm__amostra {
    display: inline-block;
    width: 14px;
    height: 14px;
    border: 1px dashed var(--linha);
    background: var(--folha);
  }
  .mdm__amostra--com {
    border: 1px solid var(--tinta-2);
    background: color-mix(in srgb, var(--trigo) 55%, var(--folha));
  }
  .mdm__fonte {
    margin: 0;
    font-size: 10px;
    color: var(--tinta-3);
  }
</style>
