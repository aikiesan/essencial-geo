---
/**
 * Navegação dentro da coleção, no pé da página do mapa: anterior e próxima na ordem de leitura
 * e a fita de miniaturas das pranchas no ar, com a atual marcada.
 */
import { Image } from 'astro:assets';
import Icone from './Icone.astro';
import { linkMapa, numeroFormatado, type Mapa } from '../lib/mapas';
import type { Colecao } from '../lib/colecoes';
import { rota, t } from '../i18n';

interface Props { mapa: Mapa; colecao: Colecao; posicao: number; total: number }
const { mapa, colecao, posicao, total } = Astro.props;
const lingua = mapa.lingua;
const tx = t(lingua);
const i = colecao.mapas.findIndex((m) => m.id === mapa.id);
const anterior = i > 0 ? colecao.mapas[i - 1] : undefined;
const proxima = i >= 0 && i < colecao.mapas.length - 1 ? colecao.mapas[i + 1] : undefined;
---

<nav class="navcol" aria-labelledby="t-navcol">
  <div class="navcol__cab">
    <p class="rotulo" id="t-navcol">
      {tx.mapa.nestaColecao} · <span class="mono">{posicao} {tx.colecoes.de} {total}</span>
    </p>
    <a class="navcol__titulo" href={rota(lingua, 'colecoes', colecao.id)}>
      {colecao.titulo} <Icone nome="seta" tamanho={12} />
    </a>
  </div>

  <div class="navcol__passos">
    {
      anterior ? (
        <a href={linkMapa(anterior)} rel="prev">
          <span class="rotulo"><Icone nome="voltar" tamanho={11} /> {tx.mapa.anterior} · {tx.geral.no} {numeroFormatado(anterior.data.numero)}</span>
          <span class="navcol__passo-titulo">{anterior.data.titulo}</span>
        </a>
      ) : (
        <p class="navcol__limite">{tx.mapa.primeira}</p>
      )
    }
    {
      proxima ? (
        <a href={linkMapa(proxima)} rel="next" class="navcol__dir">
          <span class="rotulo">{tx.mapa.proxima} · {tx.geral.no} {numeroFormatado(proxima.data.numero)} <Icone nome="seta" tamanho={11} /></span>
          <span class="navcol__passo-titulo">{proxima.data.titulo}</span>
        </a>
      ) : (
        <p class="navcol__limite navcol__dir">{tx.mapa.ultima}</p>
      )
    }
  </div>

  {
    colecao.mapas.length > 1 && (
      <ol class="navcol__fita" role="list" aria-label={tx.colecoes.sumario}>
        {colecao.mapas.map((m) => (
          <li>
            <a href={linkMapa(m)} aria-current={m.id === mapa.id ? 'page' : undefined} title={m.data.titulo}>
              <Image src={m.data.imagem} alt="" widths={[160, 240]} sizes="120px" loading="lazy" format="webp" quality={68} />
              <span class="mono">{numeroFormatado(m.data.numero)}</span>
              <span class="sr-only">{m.data.titulo}</span>
            </a>
          </li>
        ))}
      </ol>
    )
  }
</nav>

<style>
  .navcol {
    margin-top: var(--e-7);
    padding-top: var(--e-4);
    border-top: 1px solid var(--linha);
  }
  .navcol__cab {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--e-1) var(--e-4);
  }
  .navcol__cab .rotulo {
    margin: 0;
  }
  .navcol__titulo {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    font-family: var(--f-titulo);
    font-size: var(--t-lg);
    text-decoration: none;
    color: var(--tinta);
  }
  .navcol__titulo:hover {
    color: var(--acento);
  }
  .navcol__passos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--e-3);
    margin-top: var(--e-4);
  }
  .navcol__passos a {
    display: grid;
    align-content: start;
    gap: var(--e-1);
    padding: var(--e-3);
    border: 1px solid var(--linha-fina);
    text-decoration: none;
    color: var(--tinta);
  }
  .navcol__passos a:hover,
  .navcol__passos a:focus-visible {
    border-color: var(--acento);
  }
  .navcol__passos .rotulo {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-1);
  }
  .navcol__passo-titulo {
    font-family: var(--f-titulo);
    font-size: var(--t-md);
    line-height: 1.25;
  }
  .navcol__dir {
    text-align: right;
    justify-items: end;
  }
  .navcol__dir .rotulo {
    justify-content: flex-end;
  }
  .navcol__limite {
    margin: 0;
    padding: var(--e-3);
    border: 1px dashed var(--linha-fina);
    font-size: var(--t-sm);
    font-style: italic;
    color: var(--tinta-3);
  }
  @media (max-width: 559px) {
    .navcol__passos {
      grid-template-columns: 1fr;
    }
    .navcol__dir {
      text-align: left;
      justify-items: start;
    }
    .navcol__dir .rotulo {
      justify-content: flex-start;
    }
  }

  /* Fita de miniaturas: rola na horizontal, a atual com filete de acento */
  .navcol__fita {
    display: flex;
    gap: var(--e-2);
    margin: var(--e-4) 0 0;
    padding: 0 0 var(--e-2);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
  }
  .navcol__fita li {
    flex: none;
    scroll-snap-align: start;
  }
  .navcol__fita a {
    display: grid;
    gap: 2px;
    width: 104px;
    padding: 3px;
    border: 1px solid var(--linha-fina);
    background: var(--folha);
    text-decoration: none;
    color: var(--tinta-3);
    font-size: var(--t-xs);
    text-align: center;
  }
  .navcol__fita a:hover,
  .navcol__fita a:focus-visible {
    border-color: var(--acento);
  }
  .navcol__fita a[aria-current='page'] {
    border-color: var(--linha);
    box-shadow: inset 0 -2px 0 var(--acento);
    color: var(--tinta);
  }
  .navcol__fita :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: #fff;
  }
</style>
