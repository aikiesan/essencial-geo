---
/**
 * Ficha técnica: leitura rápida (indicadores), camadas, metadados, downloads
 * diretos e citação acadêmica (ABNT, APA, BibTeX).
 * Pode aparecer mais de uma vez na mesma página (coluna direita e dentro do
 * cartão em telas estreitas), por isso não usa ids — só atributos data-*.
 */
import Icone from './Icone.astro';
import LeituraRapida from './LeituraRapida.astro';
import { SITE } from '../site.config';
import { citar } from '../lib/citacao';
import { emLingua, linkMapa, nomeFonte, numeroFormatado, resolverDownloads, urlAbsoluta, type Mapa } from '../lib/mapas';
import { dataCurta, t } from '../i18n';

interface Props {
  mapa: Mapa;
  /** Mostra o cabeçalho com número e título (útil na coluna direita do feed). */
  cabecalho?: boolean;
}

const { mapa, cabecalho = false } = Astro.props;
const d = mapa.data;
const lingua = mapa.lingua;
const tx = t(lingua);
const downloads = resolverDownloads(mapa);
const permalink = urlAbsoluta(linkMapa(mapa), Astro.site);
const citacao = citar(mapa, permalink);
// A aba aberta por padrão: ABNT para quem lê em português, APA para quem lê em inglês.
const formatos = lingua === 'en' ? (['apa', 'abnt', 'bibtex'] as const) : (['abnt', 'apa', 'bibtex'] as const);
const ROTULO_FORMATO = { abnt: 'ABNT', apa: 'APA', bibtex: 'BibTeX' };
---

<section class="ficha" aria-label={`${tx.ficha.rotulo} — ${d.titulo}`}>
  {
    cabecalho && (
      <header class="ficha__cab">
        <p class="rotulo">
          {tx.ficha.rotulo} · {tx.geral.no} {numeroFormatado(d.numero)}
        </p>
        <p class="ficha__titulo">
          <a href={linkMapa(mapa)}>{d.titulo}</a>
        </p>
      </header>
    )
  }

  {
    d.indicadores.length > 0 && (
      <>
        <h3 class="secao">{tx.ficha.leitura}</h3>
        <LeituraRapida mapa={mapa} />
      </>
    )
  }

  {
    d.camadas.length > 0 && (
      <>
        <h3 class="secao">{tx.ficha.camadas}</h3>
        <ul class="camadas" role="list">
          {d.camadas.map((c) => (
            <li class="camada">
              <span class="camada__cor" style={c.cor ? `--cor: ${c.cor}` : undefined} aria-hidden="true" />
              <span class="camada__nome mono">{c.nome}</span>
              <span class:list={['camada__tipo', `camada__tipo--${c.tipo}`]}>{tx.ficha.tipos[c.tipo]}</span>
              {emLingua(c, 'descricao', lingua) && <span class="camada__desc">{emLingua(c, 'descricao', lingua)}</span>}
            </li>
          ))}
        </ul>
      </>
    )
  }

  <h3 class="secao">{tx.ficha.metadados}</h3>
  <dl class="ficha__dados">
    <div>
      <dt>{d.fontes.length > 1 ? tx.ficha.fontes : tx.ficha.fonte}</dt>
      <dd>
        {
          d.fontes.map((f, i) => (
            <>
              {f.url ? <a href={f.url} rel="noopener">{nomeFonte(f, lingua)}</a> : nomeFonte(f, lingua)}
              {f.ano && <span class="mono"> ({f.ano})</span>}
              {i < d.fontes.length - 1 && <br />}
            </>
          ))
        }
      </dd>
    </div>
    <div><dt>{tx.ficha.recorte}</dt><dd>{d.recorte}</dd></div>
    <div>
      <dt>{tx.ficha.crs}</dt>
      <dd class="mono">
        {d.crs}
        {d.epsg && (
          <>
            <br />
            <a href={`https://epsg.io/${d.epsg}`} rel="noopener">EPSG:{d.epsg}</a>
          </>
        )}
      </dd>
    </div>
    {d.escala && <div><dt>{tx.ficha.escala}</dt><dd class="mono">{d.escala}</dd></div>}
    {d.software.length > 0 && <div><dt>{tx.ficha.software}</dt><dd class="mono">{d.software.join(' · ')}</dd></div>}
    {d.metodo && <div><dt>{tx.ficha.metodo}</dt><dd>{d.metodo}</dd></div>}
    <div>
      <dt>{tx.ficha.versao}</dt>
      <dd class="mono">
        v{d.versao} · {dataCurta(d.atualizado ?? d.data, lingua)}
      </dd>
    </div>
    <div>
      <dt>{tx.ficha.licenca}</dt>
      <dd><a href={SITE.licenca.url[lingua]} rel="license noopener">{SITE.licenca.nome}</a></dd>
    </div>
    <div>
      <dt>{tx.ficha.doi}</dt>
      <dd class="mono">
        {d.doi ? <a href={`https://doi.org/${d.doi}`} rel="noopener" data-goatcounter-click={`doi/${mapa.id}`}>{d.doi}</a> : <span class="ficha__pendente">{tx.ficha.doiPendente}</span>}
      </dd>
    </div>
  </dl>

  <h3 class="secao">{tx.ficha.downloads}</h3>
  {
    downloads.length === 0 ? (
      <p class="ficha__vazio rotulo">{tx.ficha.semArquivos}</p>
    ) : (
      <ul class="ficha__downloads" role="list">
        {downloads.map((a) => (
          <li>
            {a.href ? (
              <a
                class="arquivo"
                href={a.href}
                download={a.externo ? undefined : ''}
                rel={a.externo ? 'noopener' : undefined}
                data-goatcounter-click={`baixar/${mapa.id}/${a.formato}/${lingua}`}
                data-goatcounter-title={`${a.rotulo} (${a.ext})`}
              >
                <span class="arquivo__sigla">{a.sigla}</span>
                <span class="arquivo__rotulo">
                  {a.rotulo} <span class="arquivo__ext">({a.ext})</span>
                </span>
                {a.tamanho && <span class="arquivo__tam">{a.tamanho}</span>}
                <Icone nome={a.externo ? 'externo' : 'baixar'} class="arquivo__icone" />
              </a>
            ) : (
              <span class="arquivo" aria-disabled="true" title={tx.ficha.naoPublicado}>
                <span class="arquivo__sigla">{a.sigla}</span>
                <span class="arquivo__rotulo">
                  {a.rotulo} <span class="arquivo__ext">({a.ext})</span>
                </span>
                <span class="arquivo__tam">{tx.ficha.emBreve}</span>
              </span>
            )}
          </li>
        ))}
      </ul>
    )
  }

  <h3 class="secao">{tx.ficha.citar}</h3>
  <div class="citacao" data-citacao>
    <div class="citacao__abas" role="group" aria-label={tx.ficha.formatoCitacao}>
      {
        formatos.map((f, i) => (
          <button type="button" class="citacao__aba" data-formato={f} aria-pressed={i === 0 ? 'true' : 'false'}>
            {ROTULO_FORMATO[f]}
          </button>
        ))
      }
    </div>
    <p class="citacao__texto" data-bloco="abnt" lang="pt-BR" hidden={formatos[0] !== 'abnt'} set:html={citacao.abnt.html} />
    <p class="citacao__texto" data-bloco="apa" hidden={formatos[0] !== 'apa'} set:html={citacao.apa.html} />
    <pre class="citacao__texto citacao__bib" data-bloco="bibtex" hidden>{citacao.bibtex}</pre>
    <button
      type="button"
      class="botao citacao__copiar"
      data-copiar
      data-rotulo-copiar={tx.ficha.copiar}
      data-rotulo-copiado={tx.ficha.copiado}
      data-rotulo-manual={tx.ficha.copieManual}
    >
      <Icone nome="copiar" />
      <span data-copiar-rotulo>{tx.ficha.copiar}</span>
    </button>
  </div>
</section>

<style>
  .ficha {
    font-size: var(--t-sm);
    line-height: 1.5;
  }
  .ficha .secao {
    margin-top: var(--e-6);
  }
  .ficha .secao:first-of-type {
    margin-top: var(--e-4);
  }
  .ficha__cab {
    padding-bottom: var(--e-3);
    border-bottom: 1px solid var(--linha);
  }
  .ficha__titulo {
    margin: var(--e-1) 0 0;
    font-family: var(--f-titulo);
    font-size: var(--t-lg);
    line-height: 1.2;
  }
  .ficha__titulo a {
    text-decoration: none;
  }
  .ficha__dados {
    margin: 0;
    border-top: 1px solid var(--linha);
  }
  .ficha__dados > div {
    display: grid;
    grid-template-columns: 7.5em minmax(0, 1fr);
    gap: var(--e-3);
    padding: var(--e-2) 0;
    border-bottom: 1px solid var(--linha-fina);
  }
  .ficha__dados dt {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tinta-3);
    padding-top: 0.15em;
  }
  .ficha__dados dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .ficha__dados dd.mono {
    font-size: 0.75rem;
  }
  .ficha__pendente {
    color: var(--tinta-3);
    font-style: italic;
  }

  .ficha__downloads {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--e-2);
  }
  .arquivo {
    display: grid;
    grid-template-columns: 3.4em minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--e-3);
    min-height: 44px;
    padding: var(--e-2) var(--e-3) var(--e-2) 0;
    border: 1px solid var(--linha);
    text-decoration: none;
    font-family: var(--f-mono);
    font-size: 0.75rem;
    transition: background-color 120ms linear, color 120ms linear;
  }
  .arquivo__sigla {
    align-self: stretch;
    display: grid;
    place-items: center;
    border-right: 1px solid var(--linha);
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .arquivo__ext,
  .arquivo__tam {
    color: var(--tinta-3);
  }
  .arquivo__tam {
    font-size: var(--t-xs);
  }
  a.arquivo:hover {
    background: var(--tinta);
    color: var(--papel);
  }
  a.arquivo:hover .arquivo__ext,
  a.arquivo:hover .arquivo__tam {
    color: inherit;
  }
  .arquivo[aria-disabled='true'] {
    border-style: dashed;
    border-color: var(--tinta-3);
    color: var(--tinta-3);
  }
  .arquivo[aria-disabled='true'] .arquivo__sigla {
    border-right-style: dashed;
    border-color: var(--tinta-3);
  }
  .ficha__vazio {
    margin: 0;
  }

  .citacao__abas {
    display: flex;
    margin-bottom: -1px;
  }
  .citacao__aba {
    padding: var(--e-1) var(--e-3);
    border: 1px solid var(--linha-fina);
    border-bottom-color: var(--linha);
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.1em;
    color: var(--tinta-3);
  }
  .citacao__aba + .citacao__aba {
    border-left: 0;
  }
  .citacao__aba[aria-pressed='true'] {
    border-color: var(--linha);
    border-bottom-color: var(--trigo);
    background: var(--trigo);
    color: var(--tinta);
  }
  .citacao__texto {
    margin: 0;
    padding: var(--e-3);
    border: 1px solid var(--linha);
    background: var(--trigo);
    font-family: var(--f-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .citacao__bib {
    white-space: pre-wrap;
    overflow-x: auto;
  }
  .citacao__copiar {
    margin-top: var(--e-2);
    width: 100%;
    justify-content: center;
  }
  /* Camadas: como o painel de camadas de um SIG web — cor, nome, tipo de geometria */
  .camadas {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--linha);
  }
  .camada {
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--e-1) var(--e-3);
    padding: var(--e-2) 0;
    border-bottom: 1px solid var(--linha-fina);
  }
  .camada__cor {
    width: 12px;
    height: 12px;
    background: var(--cor, var(--nilo));
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.25);
  }
  .camada__nome {
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }
  .camada__tipo {
    padding: 0 var(--e-2);
    border: 1px solid var(--linha-fina);
    background: var(--trigo);
    color: var(--tinta-2);
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    line-height: 1.7;
    white-space: nowrap;
  }
  .camada__tipo::before {
    margin-right: 0.4em;
    color: var(--tinta-3);
  }
  .camada__tipo--ponto::before { content: '●'; }
  .camada__tipo--linha::before { content: '╱'; }
  .camada__tipo--poligono::before { content: '▰'; }
  .camada__tipo--grade::before { content: '▦'; }
  .camada__tipo--raster::before { content: '▩'; }
  .camada__desc {
    grid-column: 2 / -1;
    color: var(--tinta-2);
    font-size: var(--t-xs);
    line-height: 1.45;
  }

  .citacao__copiar[data-copiado] {
    background: var(--floresta);
    border-color: var(--floresta);
    color: #dfd5c4;
  }
</style>
