---
/** Pequena estrela de cinco pontas — o eco discreto de Saint-Exupéry. */
interface Props { tamanho?: number; class?: string; titulo?: string }
const { tamanho = 11, class: classe = '', titulo } = Astro.props;
---
<svg
  class:list={['estrela', classe]}
  width={tamanho}
  height={tamanho}
  viewBox="0 0 24 24"
  aria-hidden={titulo ? undefined : 'true'}
  role={titulo ? 'img' : undefined}
>
  {titulo && <title>{titulo}</title>}
  <path fill="currentColor" d="M12 1.8l2.95 6.98 7.55.62-5.73 4.96 1.73 7.38L12 17.8l-6.5 3.94 1.73-7.38L1.5 9.4l7.55-.62z" />
</svg>
