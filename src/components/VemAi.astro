---
/**
 * "Vem aí": a próxima prancha agendada de uma coleção, com número, título, tese e a data.
 * A data vem escrita por extenso; com JavaScript, ganha a contagem regressiva ("daqui a 4 dias").
 * Sem imagem: a prancha ainda não saiu.
 */
import Estrela from './Estrela.astro';
import { numeroFormatado, type Mapa } from '../lib/mapas';
import { dataExtensa, dataIso, t } from '../i18n';

interface Props { mapa: Mapa }
const { mapa } = Astro.props;
const lingua = mapa.lingua;
const tx = t(lingua);
---

<aside class="vem-ai" aria-labelledby={`vem-ai-${mapa.id}`}>
  <p class="vem-ai__rotulo rotulo" id={`vem-ai-${mapa.id}`}>
    <Estrela tamanho={10} />
    {tx.colecoes.vemAi}
  </p>
  <p class="vem-ai__no mono">{tx.geral.no} {numeroFormatado(mapa.data.numero)}</p>
  <p class="vem-ai__titulo">{mapa.data.titulo}</p>
  {mapa.data.subtitulo && <p class="vem-ai__tese">{mapa.data.subtitulo}</p>}
  <p class="vem-ai__data rotulo">
    <time datetime={dataIso(mapa.data.data)} data-contagem="somar">{dataExtensa(mapa.data.data, lingua)}</time>
  </p>
</aside>

<style>
  /* Um recorte tracejado, como a parada agendada do percurso: o espaço da prancha que ainda vem */
  .vem-ai {
    position: relative;
    display: grid;
    gap: var(--e-1);
    max-width: 560px;
    margin: var(--e-5) 0 0;
    padding: var(--e-4) var(--e-4) var(--e-3);
    border: 1px dashed var(--linha);
    background: var(--folha);
  }
  .vem-ai::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    width: 14px;
    height: 14px;
    border-top: 1px solid var(--cesto);
    border-left: 1px solid var(--cesto);
  }
  .vem-ai p {
    margin: 0;
  }
  .vem-ai__rotulo {
    display: inline-flex;
    align-items: center;
    gap: var(--e-1);
    color: var(--cesto);
  }
  .vem-ai__no {
    font-size: var(--t-xs);
    color: var(--tinta-3);
  }
  .vem-ai__titulo {
    font-family: var(--f-titulo);
    font-size: var(--t-lg);
    line-height: 1.25;
  }
  .vem-ai__tese {
    font-style: italic;
    font-size: var(--t-sm);
    line-height: 1.5;
    color: var(--tinta-2);
  }
  .vem-ai__data {
    margin-top: var(--e-1) !important;
    color: var(--tinta);
  }
  .vem-ai__data time::first-letter {
    text-transform: uppercase;
  }
</style>
