---
/** Ícones de traço fino (1px), desenhados numa grade de 16. */
const caminhos = {
  baixar: 'M8 2v8.5M4.5 7.5 8 11l3.5-3.5M2.5 13.5h11',
  externo: 'M6 3H3v10h10v-3M9 2.5h4.5V7M13.5 2.5 7 9',
  copiar: 'M5.5 5.5h8v8h-8zM10.5 5.5v-3h-8v8h3',
  ampliar: 'M2.5 2.5h11v11h-11zM8 5v6M5 8h6',
  reduzir: 'M2.5 2.5h11v11h-11zM5 8h6',
  enquadrar: 'M2.5 6V2.5H6M10 2.5h3.5V6M13.5 10v3.5H10M6 13.5H2.5V10',
  fechar: 'M3 3l10 10M13 3 3 13',
  menu: 'M2 4.5h12M2 8h12M2 11.5h12',
  seta: 'M2.5 8h11M9.5 4l4 4-4 4',
  voltar: 'M13.5 8h-11M6.5 4l-4 4 4 4',
  tema: 'M8 2.5a5.5 5.5 0 1 0 0 11z M8 2.5a5.5 5.5 0 0 1 0 11',
  rss: 'M3 3a10 10 0 0 1 10 10M3 7a6 6 0 0 1 6 6M3.5 12.5h.01',
  ok: 'M3 8.5 6.5 12 13 4.5',
} as const;

interface Props { nome: keyof typeof caminhos; tamanho?: number; class?: string }
const { nome, tamanho = 14, class: classe } = Astro.props;
---
<svg
  class:list={['icone', classe]}
  width={tamanho}
  height={tamanho}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1"
  stroke-linecap="square"
  aria-hidden="true"
>
  <path d={caminhos[nome]} />
</svg>
